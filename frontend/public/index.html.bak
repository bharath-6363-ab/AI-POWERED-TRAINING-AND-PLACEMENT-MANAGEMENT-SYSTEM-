                                <td class="p-3"><span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded font-bold text-[10px]">ELIGIBLE</span></td>
                                <td class="p-3 text-right"><a href="/api/v1/reports/student/1/download" target="_blank" class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded font-bold text-[11px]">Download PDF</a></td>
