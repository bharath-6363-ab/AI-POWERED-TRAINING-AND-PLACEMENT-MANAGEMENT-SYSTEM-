                    </button>
                    <button id="btnFilterProduct" onclick="filterCompanyCategory('PRODUCT')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                        🚀 Product-Based (<span id="cntProduct">15</span>)
                    </button>
                    <button id="btnFilterService" onclick="filterCompanyCategory('SERVICE')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-blue-50 hover:text-blue-700">
                        💼 Service-Based (<span id="cntService">15</span>)
                    </button>
                </div>

                <!-- Live Search Box -->
                <div class="w-full sm:w-64 relative">
                    <input type="text" id="jobSearchInput" onkeyup="filterJobsByText()" placeholder="Search company or role..." class="w-full text-xs pl-8 pr-3 py-2 border rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 bg-slate-50">
                    <i data-lucide="search" class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-2.5"></i>
                </div>
            </div>

            <!-- Job Cards Grid -->
            <div id="placementJobContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Dynamically populated via loadPlacementJobsLive() -->
            </div>
        </div>

        <!-- View 5: Admin & Proctoring Control Center -->
        <div id="view-admin" class="space-y-6 hidden">
            <!-- Admin Top Header Banner -->
            <div class="bg-gradient-to-r from-purple-950 via-indigo-950 to-slate-950 text-white p-6 rounded-2xl border border-purple-800/50 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="bg-purple-600 text-purple-100 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">TPO Admin Directorate</span>
                        <span class="text-purple-300 text-xs font-mono flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>Live Proctoring Active</span>
                    </div>
                    <h2 class="text-xl font-bold text-white">Placement Officer & AI Proctoring Control Center</h2>
                    <p class="text-xs text-purple-200 mt-1 max-w-2xl">Monitor real-time AI mock interview security integrity, audit candidate 2-person intrusion alerts, configure drive cutoffs, and export official student dossier reports.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="runEligibilityReindex()" class="px-4 py-2.5 bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-2 shadow">
