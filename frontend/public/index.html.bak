    </main>

    <script>
        // Tab Navigation
        function showTab(id) {
            // Role Guard for Admin Directorate
            if (id === 'admin' && currentUser.role !== 'admin' && currentUser.role !== 'trainer') {
                alert("ACCESS RESTRICTED: The Admin & Proctoring Directorate is only accessible to TPO Admins and Institutional Faculty. Please log in with an Admin account.");
                return;
            }

            ['dashboard', 'pipeline', 'resume', 'interview', 'placement', 'admin'].forEach(t => {
                const view = document.getElementById('view-' + t);
                const tab = document.getElementById('tab-' + t);
                if (view) view.classList.add('hidden');
                if (tab) tab.className = "py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 whitespace-nowrap";
            });
            const activeView = document.getElementById('view-' + id);
            const activeTab = document.getElementById('tab-' + id);
            if (activeView) activeView.classList.remove('hidden');
            if (activeTab) activeTab.className = "py-3 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap flex items-center gap-1.5";
            if (window.lucide) lucide.createIcons();

            if (id === 'interview') {
                if (!mediaStream && !isSimulated) {
                    isSimulated = true;
                    startSimulatedVideoFeed();
                }
                fetchRandomizedQuestions();
            } else if (id === 'placement') {
                loadPlacementJobsLive();
            } else if (id === 'resume' || id === 'pipeline') {
                loadSequentialPipelineWorkflow();
            }
        }

        function switchRole(role) {
            alert('Switched active role perspective: ' + role);
        }

        // State Management
        let currentResumeSkills = ['Python', 'FastAPI', 'React', 'SQL', 'Docker'];
        let interviewQuestions = [
            {
                topic: "Python",
                difficulty: "medium",
                question_text: "Can you explain how Python manages memory, specifically focusing on reference counting and garbage collection?",
                expected_concepts: ["reference counting", "garbage collection", "cyclic references", "memory leaks"],
                ideal_summary: "Python uses reference counting as its primary memory management mechanism along with a generational garbage collector to detect reference cycles."
            },
            {
                topic: "FastAPI",
                difficulty: "medium",
                question_text: "What makes FastAPI so performant, and how does it utilize Pydantic and async/await syntax?",
                expected_concepts: ["async", "await", "starlette", "pydantic", "validation"],
                ideal_summary: "FastAPI leverages Starlette for asynchronous ASGI performance and Pydantic for automated data validation, type hints, and OpenAPI schema generation."
            },
            {
                topic: "React",
                difficulty: "medium",
                question_text: "How does React's Virtual DOM and reconciliation algorithm work, and why are keys essential when rendering dynamic lists?",
                expected_concepts: ["virtual dom", "reconciliation", "diffing", "keys", "render"],
                ideal_summary: "React maintains a virtual DOM tree and uses a diffing algorithm during reconciliation to apply minimal updates to the real DOM. Stable keys allow React to identify moved elements."
            },
            {
                topic: "SQL & Databases",
                difficulty: "medium",
                question_text: "Explain the difference between clustered and non-clustered indexes in relational databases, and when would you avoid creating an index?",
                expected_concepts: ["clustered index", "b-tree", "physical order", "write overhead"],
                ideal_summary: "A clustered index determines the physical storage order of table data, while non-clustered indexes maintain a separate lookup pointer structure. Avoid over-indexing high write tables."
            }
        ];
        let currentQIndex = 0;

        let mediaStream = null;
        let audioContext = null;
        let analyser = null;
        let audioSource = null;
        let audioAnimId = null;
        let isMicMuted = false;
        let isSimulated = false;
        let speechRecognizer = null;
        let isSpeechRecognizing = false;
        let speechFinalTranscript = '';
        let answerStartTime = null;
        let recTimerInterval = null;
        let recSeconds = 0;

        // Dynamic Question Navigation
        function renderCurrentQuestion() {
            const q = interviewQuestions[currentQIndex];
            if (!q) return;

            const qIndexBadge = document.getElementById('qIndexBadge');
            const qTopicBadge = document.getElementById('qTopicBadge');
            const qDiffBadge = document.getElementById('qDiffBadge');
            const currentQText = document.getElementById('currentQuestionText');
            const conceptsContainer = document.getElementById('targetConceptsContainer');
            const btnPrev = document.getElementById('btnPrevQ');
            const btnNext = document.getElementById('btnNextQ');

            if (qIndexBadge) qIndexBadge.innerText = `Question ${currentQIndex + 1} of ${interviewQuestions.length}`;
            if (qTopicBadge) qTopicBadge.innerText = q.topic || "Technical Core";
            if (qDiffBadge) qDiffBadge.innerText = (q.difficulty || "medium").toUpperCase();
            if (currentQText) currentQText.innerText = q.question_text;

            if (conceptsContainer && q.expected_concepts) {
                conceptsContainer.innerHTML = '<span class="text-[10px] text-slate-400 mr-1 self-center">Target Concepts:</span>' +
                    q.expected_concepts.map(c => `<span class="text-[10px] bg-slate-700/70 text-slate-300 px-2 py-0.5 rounded">${c}</span>`).join('');
            }

            if (btnPrev) btnPrev.disabled = (currentQIndex === 0);
            if (btnNext) btnNext.disabled = (currentQIndex === interviewQuestions.length - 1);

            // Fresh Candidate Response per Question
            const input = document.getElementById('liveAnswerInput');
            if (input) {
                input.value = "";
                updateWordCount();
            }
        }

        function toggleConceptsHint() {
            const container = document.getElementById('targetConceptsContainer');
            const btnText = document.getElementById('hintBtnText');
            if (!container) return;
            if (container.classList.contains('hidden')) {
                container.classList.remove('hidden');
                if (btnText) btnText.innerText = "Hide Concepts Hint";
            } else {
                container.classList.add('hidden');
                if (btnText) btnText.innerText = "Key Concepts Hint";
            }
        }

        async function changeInterviewDomain() {
            const domainSelect = document.getElementById('interviewDomainSelect');
            const val = domainSelect ? domainSelect.value : 'resume';
            const skillsBadge = document.getElementById('activeSkillsList');

            let skills = currentResumeSkills;
            let jobTitle = "Software Engineer";

            if (val === 'python') {
                skills = ['Python', 'FastAPI', 'REST APIs', 'SQL'];
                jobTitle = "Python Backend Engineer";
            } else if (val === 'fullstack') {
                skills = ['React', 'JavaScript', 'FastAPI', 'CSS', 'REST APIs'];
                jobTitle = "Full Stack Engineer";
            } else if (val === 'java') {
                skills = ['Java', 'Spring Boot', 'OOP', 'Microservices', 'SQL'];
                jobTitle = "Java Enterprise Developer";
            } else if (val === 'dsa') {
                skills = ['Data Structures', 'Algorithms', 'Arrays', 'Trees', 'Graphs', 'Dynamic Programming'];
                jobTitle = "Algorithm & Core CS Specialist";
            } else if (val === 'sql') {
                skills = ['SQL', 'PostgreSQL', 'Indexing', 'Query Optimization', 'Transactions'];
                jobTitle = "Database & SQL Engineer";
            } else if (val === 'cloud') {
                skills = ['Docker', 'Kubernetes', 'CI/CD', 'AWS', 'Linux'];
                jobTitle = "Cloud & DevOps Engineer";
            } else if (val === 'hr') {
                skills = ['Leadership', 'Communication', 'Conflict Resolution', 'Teamwork'];
                jobTitle = "HR & Behavioral Round";
            }

            if (skillsBadge) {
                skillsBadge.innerText = `Active Track: ${skills.join(', ')}`;
            }

            try {
                const resp = await fetch('/api/v1/interviews/questions/from-resume', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ skills, job_title: jobTitle, count: 4 })
                });
                const data = await resp.json();
                if (data.questions && data.questions.length > 0) {
                    interviewQuestions = data.questions;
                    currentQIndex = 0;
                    renderCurrentQuestion();
                }
            } catch(e) {
                console.warn("Domain questions load error:", e);
            }
        }

        function nextQuestion() {
            if (currentQIndex < interviewQuestions.length - 1) {
                currentQIndex++;
                renderCurrentQuestion();
            }
        }

        function prevQuestion() {
            if (currentQIndex > 0) {
                currentQIndex--;
                renderCurrentQuestion();
            }
        }

        async function fetchRandomizedQuestions() {
            try {
                const btn1 = document.getElementById('btnRegenerateQ');
                const btn2 = document.getElementById('btnRegenerateQ2');
                if (btn1) btn1.innerHTML = `<i data-lucide="loader" class="w-3.5 h-3.5 animate-spin"></i><span>Loading...</span>`;
                if (btn2) btn2.innerHTML = `<i data-lucide="loader" class="w-3.5 h-3.5 animate-spin"></i><span>Loading...</span>`;

                const resp = await fetch('/api/v1/interviews/questions/from-resume', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        skills: currentResumeSkills,
                        job_title: "Software Engineer",
                        count: 4
                    })
                });
                const data = await resp.json();
                if (data.questions && data.questions.length > 0) {
                    interviewQuestions = data.questions;
                    currentQIndex = 0;
                    renderCurrentQuestion();
                }
            } catch(err) {
                console.warn("Failed to fetch randomized questions:", err);
            } finally {
                const btn1 = document.getElementById('btnRegenerateQ');
                const btn2 = document.getElementById('btnRegenerateQ2');
                if (btn1) btn1.innerHTML = `<i data-lucide="shuffle" class="w-3.5 h-3.5 text-amber-300"></i><span>Regenerate New Questions</span>`;
                if (btn2) btn2.innerHTML = `<i data-lucide="shuffle" class="w-3.5 h-3.5 text-indigo-600"></i><span>Shuffle Questions</span>`;
                if (window.lucide) lucide.createIcons();
            }
        }

        function insertSampleAnswer() {
            const q = interviewQuestions[currentQIndex];
            if (!q) return;
            const input = document.getElementById('liveAnswerInput');
            if (input) {
                input.value = q.ideal_summary || "";
                updateWordCount();
            }
        }

        function updateWordCount() {
            const input = document.getElementById('liveAnswerInput');
            if (!input) return;
            const text = input.value.trim();
            const count = text ? text.split(/\s+/).filter(Boolean).length : 0;
            const badge = document.getElementById('wordCountBadge');
            if (badge) badge.innerText = `${count} words`;
        }

