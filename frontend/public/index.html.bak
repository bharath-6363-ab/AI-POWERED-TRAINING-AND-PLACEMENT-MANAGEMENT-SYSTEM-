                    <button onclick="downloadMyReport()" class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-white border border-white/20 text-xs font-bold rounded-xl transition flex items-center gap-2 cursor-pointer">
                        <i data-lucide="file-down" class="w-4 h-4 text-purple-300"></i>
                        <span>Export Student PDF</span>
                    </button>
                </div>
            </div>

            <!-- Admin Key Metric Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-bold text-slate-500 uppercase flex items-center justify-between">
                        Total Candidates <i data-lucide="users" class="w-4 h-4 text-indigo-600"></i>
