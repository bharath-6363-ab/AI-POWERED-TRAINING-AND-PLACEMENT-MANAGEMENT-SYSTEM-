        async function handleCredentialsLogin(e) {
            e.preventDefault();
            const email = document.getElementById('loginEmail').value.trim();
            const password = document.getElementById('loginPassword').value.trim();

            try {
                const resp = await fetch('/api/v1/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });
                
                let data = {};
                try {
                    data = await resp.json();
                } catch(je) {
                    data = { detail: `Server HTTP ${resp.status} response` };
                }

                if (resp.ok && data.access_token) {
                    currentUser = {
                        user_id: data.user_id,
                        student_id: data.student_id || data.user_id,
                        full_name: data.full_name,
                        email: data.email,
                        role: data.role,
                        access_token: data.access_token
                    };
                    updateUserHeaderUI();
                    closeLoginModal();
                    if (currentUser.role === 'admin') {
                        showTab('admin');
                    }
                    alert(`LOGIN SUCCESS:\nWelcome back, ${data.full_name}! Role: ${data.role.toUpperCase()}`);
                } else {
                    alert("Login error: " + (data.detail || "Invalid email or password"));
                }
            } catch(err) {
                alert("Network login error: " + err.message);
            }
        }

