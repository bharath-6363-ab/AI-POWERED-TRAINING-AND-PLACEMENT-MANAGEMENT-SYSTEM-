        function updateUserHeaderUI() {
            const nameEl = document.getElementById('userDisplayName');
            const emailEl = document.getElementById('userEmailDisplay');
            const badgeEl = document.getElementById('roleBadge');
            const adminTab = document.getElementById('tab-admin');
            const adminView = document.getElementById('view-admin');
            const simPanel = document.getElementById('evaluatorSimPanel');

            if (nameEl) nameEl.innerText = currentUser.full_name || "Aditi Rao";
            if (emailEl) emailEl.innerText = currentUser.email || "aditi.rao@student.edu";
            if (badgeEl) {
                badgeEl.innerText = (currentUser.role || "student").toUpperCase();
                if (currentUser.role === 'admin') {
                    badgeEl.className = "px-2.5 py-1 rounded bg-purple-600 text-white font-mono text-[11px] font-bold shadow-sm";
                } else if (currentUser.role === 'trainer') {
                    badgeEl.className = "px-2.5 py-1 rounded bg-emerald-600 text-white font-mono text-[11px] font-bold shadow-sm";
                } else {
                    badgeEl.className = "px-2.5 py-1 rounded bg-indigo-600 text-white font-mono text-[11px] font-bold shadow-sm";
                }
            }

            // Role-based Access Control: Strictly isolate Admin & Proctoring tab from students
            const isAdminOrTrainer = (currentUser.role === 'admin' || currentUser.role === 'trainer');
            if (adminTab) {
                if (isAdminOrTrainer) {
                    adminTab.classList.remove('hidden');
                } else {
                    adminTab.classList.add('hidden');
                    if (adminView && !adminView.classList.contains('hidden')) {
                        showTab('dashboard');
                    }
                }
            }

            // Proctoring Violation Debug Simulation Panel: Only visible to Evaluators/Trainers
            if (simPanel) {
                if (isAdminOrTrainer) {
                    simPanel.classList.remove('hidden');
                } else {
                    simPanel.classList.add('hidden');
                }
            }

            // Dynamic Dashboard KPIs bound to current student session
            const attVal = document.getElementById('dashAttendanceVal');
            const techVal = document.getElementById('dashTechnicalVal');
            const intVal = document.getElementById('dashInterviewVal');
            const readyVal = document.getElementById('dashReadinessVal');

            if (attVal && currentUser.attendance_pct !== undefined) attVal.innerText = `${currentUser.attendance_pct}%`;
            if (techVal && currentUser.technical_score !== undefined) techVal.innerText = `${currentUser.technical_score}%`;
            if (intVal && currentUser.interview_score !== undefined) intVal.innerText = `${currentUser.interview_score}/100`;
            if (readyVal && currentUser.readiness_index !== undefined) readyVal.innerText = `${currentUser.readiness_index}%`;
        }

        function filterAdminStudents() {
            const input = document.getElementById('adminStudentSearch');
            const filter = input ? input.value.toUpperCase() : '';
            const table = document.getElementById('adminStudentTable');
            if (!table) return;
            const tr = table.getElementsByTagName('tr');

            for (let i = 1; i < tr.length; i++) {
                const tdName = tr[i].getElementsByTagName('td')[1];
                const tdRoll = tr[i].getElementsByTagName('td')[0];
                if (tdName || tdRoll) {
                    const txtValue = (tdName ? tdName.textContent : '') + ' ' + (tdRoll ? tdRoll.textContent : '');
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = '';
                    } else {
                        tr[i].style.display = 'none';
                    }
                }
            }
        }

