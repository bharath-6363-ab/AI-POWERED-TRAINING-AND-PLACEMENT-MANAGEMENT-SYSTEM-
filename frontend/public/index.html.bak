        function clearResumeText() {
            const textInput = document.getElementById('resumeTextInput');
            if (textInput) {
                textInput.value = "";
                textInput.focus();
            }
        }

        async function runComprehensiveAtsAudit() {
            const btn = document.getElementById('btnRunAtsAudit');
            const textInput = document.getElementById('resumeTextInput');
            let text = textInput ? textInput.value.trim() : "";

            if (!text) {
                loadSampleResumeText();
                text = textInput ? textInput.value.trim() : "";
            }

            if (btn) {
                btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Auditing ATS Health...</span>`;
                btn.disabled = true;
                if (window.lucide) lucide.createIcons();
            }

            try {
                const resp = await fetch('/api/v1/resume/audit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ resume_text: text })
                });
                const data = await resp.json();
                if (data.status === 'success' && data.audit) {
                    const audit = data.audit;
                    
                    const scoreEl = document.getElementById('auditTotalScore');
                    const gradeText = document.getElementById('auditGradeBadgeText');
                    const statusText = document.getElementById('auditStatusText');
                    
                    const contactScore = document.getElementById('auditContactScore');
                    const contactSummary = document.getElementById('auditContactSummary');
                    const sectionScore = document.getElementById('auditSectionScore');
                    const sectionSummary = document.getElementById('auditSectionSummary');
                    const actionScore = document.getElementById('auditActionScore');
                    const actionSummary = document.getElementById('auditActionSummary');

                    if (scoreEl) scoreEl.innerText = `${audit.total_ats_score}/100`;
                    if (gradeText) gradeText.innerText = `GRADE ${audit.grade} (${audit.total_ats_score}/100)`;
                    if (statusText) statusText.innerText = audit.status;

                    if (contactScore) contactScore.innerText = `${audit.pillars.contact.score}/25`;
                    if (contactSummary) {
                        const c = audit.pillars.contact;
                        contactSummary.innerText = [
                            c.email ? '✓ Email' : '✗ Email',
                            c.phone ? '✓ Phone' : '✗ Phone',
                            c.github ? '✓ GitHub' : (c.linkedin ? '✓ LinkedIn' : '• Add Links')
                        ].join(' • ');
                    }

                    if (sectionScore) sectionScore.innerText = `${audit.pillars.sections.score}/25`;
                    if (sectionSummary) {
                        const s = audit.pillars.sections;
                        sectionSummary.innerText = [
                            s.has_skills ? 'Skills' : '',
                            s.has_projects ? 'Projects' : '',
                            s.has_education ? 'Education' : '',
                            s.has_experience ? 'Experience' : ''
                        ].filter(Boolean).join(' • ') || 'Sections Pending';
                    }

                    if (actionScore) actionScore.innerText = `${audit.pillars.action_impact.score}/25`;
                    if (actionSummary) {
                        const verbsCount = (audit.pillars.action_impact.action_verbs_detected || []).length;
                        actionSummary.innerText = `${verbsCount} Active Verbs Found`;
                    }

                    // Strengths
                    const strList = document.getElementById('auditStrengthsList');
                    if (strList && audit.strengths) {
                        strList.innerHTML = audit.strengths.map(s => `<li>${s}</li>`).join('');
                    }

                    // Improvements
                    const impList = document.getElementById('auditImprovementsList');
                    if (impList && audit.improvements) {
                        impList.innerHTML = audit.improvements.map(i => `<li>${i}</li>`).join('');
                    }

                    // Sync extracted skills
                    if (audit.skills_extracted && audit.skills_extracted.length > 0) {
                        currentResumeSkills = audit.skills_extracted;
                        const container = document.getElementById('skillsTagContainer');
                        if (container) {
                            container.innerHTML = currentResumeSkills.map(s =>
                                `<span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">${s}</span>`
                            ).join('');
                        }
                        const badge = document.getElementById('skillCountBadge');
                        if (badge) badge.innerText = `${currentResumeSkills.length} Skills Extracted`;
                    }
                }
            } catch(e) {
                console.warn("ATS Audit Error:", e);
            } finally {
                if (btn) {
                    btn.innerHTML = `<i data-lucide="shield-check" class="w-4 h-4 text-emerald-200"></i><span>Run Full ATS Quality Audit</span>`;
                    btn.disabled = false;
                    if (window.lucide) lucide.createIcons();
                }
            }
        }

        async function parseResumeLive() {
            const btn = document.getElementById('btnParseResume');
            const textInput = document.getElementById('resumeTextInput');
            let text = textInput ? textInput.value.trim() : "";

            if (!text) {
                loadSampleResumeText();
                text = textInput ? textInput.value.trim() : "";
            }

            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Analyzing...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            try {
                const resp = await fetch('/api/v1/resume/parse-text?text=' + encodeURIComponent(text), {
                    method: 'POST'
                });
                const data = await resp.json();
                const extracted = (data.parsed_data && data.parsed_data.skills) ? data.parsed_data.skills : [];

                if (extracted.length > 0) {
                    currentResumeSkills = extracted.map(s => s.name);
                } else {
                    currentResumeSkills = ['Python', 'SQL', 'FastAPI'];
                }

                const container = document.getElementById('skillsTagContainer');
                if (container) {
                    container.innerHTML = currentResumeSkills.map(s =>
                        `<span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">${s}</span>`
                    ).join('');
                }

                const badge = document.getElementById('skillCountBadge');
                if (badge) badge.innerText = `${currentResumeSkills.length} Skills Extracted`;

                const resumeStatusEl = document.getElementById('resumeStatusText');
                if (resumeStatusEl) {
                    resumeStatusEl.innerHTML = `Candidate Skills Verified: <strong class="text-indigo-950 font-mono">${currentResumeSkills.join(', ')}</strong>`;
                }

                // Run full ATS audit in background to keep audit metrics live
                runComprehensiveAtsAudit();

                alert(`RESUME INTELLIGENCE & VERIFICATION COMPLETE:\n\nExtracted ${currentResumeSkills.length} verified technical skills:\n• ` + currentResumeSkills.join('\n• ') + `\n\nFull ATS quality audit generated! Click 'Extract Resume & Prepare 3-Round Selection Pipeline' to start testing.`);
            } catch(e) {
                alert("Resume parsing error: " + e);
            } finally {
                btn.innerHTML = `<i data-lucide="cpu" class="w-4 h-4"></i><span>Extract Skills & Pipeline</span>`;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

        async function handleResumeFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const uploadLabel = document.getElementById('uploadFileLabel');
            const originalLabelHtml = uploadLabel ? uploadLabel.innerHTML : '';
            if (uploadLabel) {
                uploadLabel.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin text-indigo-600"></i><span>Uploading & Parsing ${file.name}...</span>`;
                if (window.lucide) lucide.createIcons();
            }

            const formData = new FormData();
            formData.append('file', file);

            try {
                const resp = await fetch('/api/v1/resume/upload-file', {
                    method: 'POST',
                    body: formData
                });

                if (!resp.ok) {
                    throw new Error(`Upload failed with HTTP ${resp.status}`);
                }

                const data = await resp.json();

                // 1. Populate raw extracted text in the textarea
                const textInput = document.getElementById('resumeTextInput');
                if (textInput && data.raw_text) {
                    textInput.value = data.raw_text;
                }

                // 2. Extract and display normalized skills
                const skillsList = data.extracted_skills || [];
                if (skillsList.length > 0) {
                    currentResumeSkills = skillsList.map(s => s.name);
                } else {
                    currentResumeSkills = ['Python', 'SQL', 'FastAPI'];
                }

                // 3. Render skill pill tags
                const container = document.getElementById('skillsTagContainer');
                if (container) {
                    container.innerHTML = currentResumeSkills.map(s =>
                        `<span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">${s}</span>`
                    ).join('');
                }

                // 4. Update count badge
                const badge = document.getElementById('skillCountBadge');
                if (badge) badge.innerText = `${currentResumeSkills.length} Skills Extracted`;

                alert(`RESUME UPLOAD SUCCESS:\n\nFile: ${file.name}\nExtracted ${currentResumeSkills.length} technical skills:\n• ` + currentResumeSkills.join('\n• ') + `\n\nClick 'Raise & Launch Interview Questions from Resume' to start tailored interview!`);
            } catch (err) {
                alert(`Resume upload failed: ${err.message || err}. Falling back to direct text reader...`);
                // Fallback for simple txt if network error
                const reader = new FileReader();
                reader.onload = function(e) {
                    const content = e.target.result;
                    const textInput = document.getElementById('resumeTextInput');
                    if (textInput) {
                        textInput.value = content;
                        parseResumeLive();
                    }
                };
                reader.readAsText(file);
            } finally {
                if (uploadLabel && originalLabelHtml) {
                    uploadLabel.innerHTML = originalLabelHtml;
                    if (window.lucide) lucide.createIcons();
                }
                // Reset file input so user can re-upload same file if desired
                event.target.value = '';
            }
        }

        function loadSampleResume(profile) {
            const textInput = document.getElementById('resumeTextInput');
            if (textInput) {
                textInput.value = `Aditi Rao - Full Stack Software Developer & AI Specialist
Skills: Python, FastAPI, React, SQL, Docker, Machine Learning, REST API, Git, Data Structures
Experience: Engineered high-throughput microservices using FastAPI and async Python. Deployed containerized applications with Docker and PostgreSQL relational schemas.`;
                parseResumeLive();
            }
        }

        async function raiseQuestionsFromResume() {
            const btn = document.getElementById('btnRaiseQuestions');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Generating Tailored Questions...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            try {
                const resp = await fetch('/api/v1/interviews/questions/from-resume', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        skills: currentResumeSkills,
                        job_title: "Software Engineer",
                        count: 4
                    })
                });
                const data = await resp.json();

                if (data.questions && data.questions.length > 0) {
                    interviewQuestions = data.questions;
                    currentQIndex = 0;

                    const activeSkillsEl = document.getElementById('activeSkillsList');
                    if (activeSkillsEl) {
                        activeSkillsEl.innerText = "Tailored to: " + currentResumeSkills.join(', ');
                    }

                    // Refresh pipeline workflow state and scroll to Round 1
                    loadSequentialPipelineWorkflow();
                    const card1 = document.getElementById('cardRound1');
                    if (card1) {
                        card1.scrollIntoView({ behavior: 'smooth' });
                    }

                    alert(`RESUME SKILLS PARSED & SELECTION PIPELINE READY:\n\nSuccessfully extracted candidate skills: ${currentResumeSkills.join(', ')}\nGenerated ${interviewQuestions.length} tailored questions for Round 3.\n\nSELECTION WORKFLOW ORDER:\n1️⃣ Step 1: Round 1 Aptitude Test (10 Questions) - LAUNCHING NOW!\n2️⃣ Step 2: Clear Round 2 Technical Test (10 Questions - Resume Tailored)\n3️⃣ Step 3: Launch Round 3 Mock AI Interview`);
                    openRoundTestModal(1, 'Round 1: General Aptitude & Logical Reasoning (10 Questions)');
                }
            } catch(e) {
                alert("Question generation error: " + e);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

        // Multi-Modal Media Stream (Webcam + Microphone)
        async function startCamAndMic() {
            if (mediaStream || isSimulated) {
                stopCamAndMic();
                return;
            }

            const videoEl = document.getElementById('webcamVideo');
            const camBadge = document.getElementById('camBadge');
            const micBadge = document.getElementById('micBadge');
            const camPrompt = document.getElementById('camPrompt');
            const audioMeter = document.getElementById('audioMeterContainer');
            const btn = document.getElementById('btnStartMedia');
            const startBtnText = document.getElementById('startBtnText');

            let streamError = null;
            try {
                // First try standard video + audio
                mediaStream = await navigator.mediaDevices.getUserMedia({ 
                    video: true, 
                    audio: true 
                });
            } catch(err1) {
                console.warn('Combined media acquisition failed, trying video-only:', err1);
                streamError = err1;
                try {
                    // Try video only
                    mediaStream = await navigator.mediaDevices.getUserMedia({ video: true });
                } catch(err2) {
                    console.warn('Video-only acquisition failed, trying audio-only:', err2);
                    streamError = err2;
                    try {
                        // Try audio only
                        mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    } catch(err3) {
                        console.error('All media acquisition attempts failed:', err3);
                        streamError = err3;
                    }
                }
            }

            if (mediaStream) {
                isSimulated = false;
                videoEl.srcObject = mediaStream;
                try {
                    await videoEl.play();
                } catch(pe) {
                    console.warn("Video play promise error:", pe);
                }
                if (camPrompt) camPrompt.style.display = 'none';

                const hasVideo = mediaStream.getVideoTracks().length > 0 && mediaStream.getVideoTracks()[0].enabled;
                const hasAudio = mediaStream.getAudioTracks().length > 0 && mediaStream.getAudioTracks()[0].enabled;

                if (hasVideo) {
                    camBadge.className = "text-[10px] bg-emerald-950/80 text-emerald-300 px-2.5 py-1 rounded font-mono border border-emerald-700 flex items-center gap-1.5 shadow-sm";
                    camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>Camera: Active';
                } else {
                    camBadge.className = "text-[10px] bg-amber-950/80 text-amber-300 px-2.5 py-1 rounded font-mono border border-amber-700 flex items-center gap-1.5 shadow-sm";
                    camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span>Camera: No Video Track';
                }

                if (hasAudio) {
                    micBadge.className = "text-[10px] bg-emerald-950/80 text-emerald-300 px-2.5 py-1 rounded font-mono border border-emerald-700 flex items-center gap-1.5 shadow-sm";
                    micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>Mic: Active';
                    setupAudioAnalyser(mediaStream);
                    if (audioMeter) audioMeter.classList.remove('hidden');
                } else {
                    micBadge.className = "text-[10px] bg-amber-950/80 text-amber-300 px-2.5 py-1 rounded font-mono border border-amber-700 flex items-center gap-1.5 shadow-sm";
                    micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400"></span>Mic: Unavailable';
                }

                startBtnText.innerText = "Stop Camera & Mic";
                btn.classList.replace('bg-indigo-600', 'bg-rose-700');
                btn.classList.replace('hover:bg-indigo-700', 'hover:bg-rose-800');

                // Launch vision overlay and frame capture loop on live mediaStream
                startSimulatedVideoFeed();
            } else {
                // Multimodal simulation fallback (runs when physical camera is denied or not connected)
                isSimulated = true;
                if (camPrompt) camPrompt.style.display = 'none';
                
                // Activate animated video canvas
                startSimulatedVideoFeed();

                camBadge.className = "text-[10px] bg-blue-950/80 text-blue-300 px-2.5 py-1 rounded font-mono border border-blue-700 flex items-center gap-1.5 shadow-sm";
                camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>Camera: Simulated';
                micBadge.className = "text-[10px] bg-blue-950/80 text-blue-300 px-2.5 py-1 rounded font-mono border border-blue-700 flex items-center gap-1.5 shadow-sm";
                micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>Mic: Simulated';
                
                if (audioMeter) audioMeter.classList.remove('hidden');
                startSimulatedAudioMeter();

                startBtnText.innerText = "Stop Video & Audio";
                btn.classList.replace('bg-indigo-600', 'bg-rose-700');
                btn.classList.replace('hover:bg-indigo-700', 'hover:bg-rose-800');

                let errMsg = "Physical camera/mic permission not granted or device not detected.";
                if (streamError) {
                    errMsg += ` (${streamError.name}: ${streamError.message})`;
                }
                errMsg += "\n\nActivated AI Candidate Visual Simulation Feed so you can test the entire interview workflow!";
                console.info(errMsg);
            }
            if (window.lucide) lucide.createIcons();
        }

        async function diagnoseHardwareMedia() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) {
                alert("Browser Error: navigator.mediaDevices is not supported in this browser context. Please access via http://127.0.0.1:8080 or http://localhost:8080 in Chrome or Edge.");
                return;
            }

            try {
                const devices = await navigator.mediaDevices.enumerateDevices();
                const videoInputs = devices.filter(d => d.kind === 'videoinput');
                const audioInputs = devices.filter(d => d.kind === 'audioinput');

                let info = `HARDWARE DEVICE DIAGNOSTIC REPORT:\n\n`;
                info += `• Cameras detected: ${videoInputs.length}\n`;
                videoInputs.forEach((c, idx) => {
                    info += `  [${idx+1}] ${c.label || 'Webcam (Label blocked until permission granted)'}\n`;
                });

                info += `\n• Microphones detected: ${audioInputs.length}\n`;
                audioInputs.forEach((m, idx) => {
                    info += `  [${idx+1}] ${m.label || 'Microphone (Label blocked until permission granted)'}\n`;
                });

                if (videoInputs.length === 0 && audioInputs.length === 0) {
                    info += `\n⚠️ Neither camera nor microphone hardware was detected by Windows. Ensure your webcam/mic is plugged in.`;
                } else {
                    info += `\nAttempting direct hardware permission request now...`;
                }

                alert(info);

                // Explicitly request user media to trigger native prompt
                try {
                    const testStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                    alert("SUCCESS: Physical Camera and Microphone permissions are GRANTED and active! Closing test stream and connecting to live interview...");
                    testStream.getTracks().forEach(t => t.stop());
                    // Auto-start actual media stream
                    if (!mediaStream) {
                        startCamAndMic();
                    }
                } catch(permErr) {
                    alert(`HARDWARE ACCESS NOTICE:\n\nError: ${permErr.name} - ${permErr.message}\n\nHOW TO FIX:\n1. Click the 'Padlock / Tune' icon next to http://127.0.0.1:8080 in your browser address bar.\n2. Set Camera & Microphone to 'Allow'.\n3. In Windows Settings > Privacy > Camera, ensure 'Camera access' is ON.\n4. Close other apps that might be using the camera (Zoom, Teams, Meet).`);
                }
            } catch(e) {
                alert("Diagnostic error: " + e.message);
            }
        }

        let simVideoAnimId = null;
        let isMultiPersonSimulated = false;
        let posePresetIndex = 0;

        const POSE_PRESETS = [
            { direction: "LOOKING_CENTER", yaw: 0.0, pitch: 0.0, roll: 0.0, color: "#22c55e", label: "CENTER_FOCUSED" },
            { direction: "LOOKING_LEFT", yaw: -32.5, pitch: 4.1, roll: -2.0, color: "#f59e0b", label: "TURNED_LEFT (DEFLECTION)" },
            { direction: "LOOKING_RIGHT", yaw: 35.2, pitch: -3.8, roll: 1.5, color: "#f59e0b", label: "TURNED_RIGHT (DEFLECTION)" },
            { direction: "LOOKING_DOWN", yaw: 2.1, pitch: 28.4, roll: 0.5, color: "#ef4444", label: "LOOKING_DOWN (DESK/NOTES)" }
        ];

        function toggleMultiPersonSim() {
            if (!isSimulated && !mediaStream) {
                startCamAndMic();
            }
            isMultiPersonSimulated = !isMultiPersonSimulated;
            const btnText = document.getElementById('multiPersonBtnText');
            if (btnText) {
                btnText.innerText = isMultiPersonSimulated ? "Single Candidate Mode" : "Multi-Person Test";
            }

            const alertNotice = isMultiPersonSimulated 
                ? "SECURITY TEST ACTIVE: Multi-Person Intrusion Mode Enabled (2 Persons Detected)!"
                : "SECURITY TEST RESET: Single Candidate Normal Mode Restored.";
            alert(alertNotice);
        }

        function toggleHeadPoseSim() {
            if (!isSimulated && !mediaStream) {
                startCamAndMic();
            }
            posePresetIndex = (posePresetIndex + 1) % POSE_PRESETS.length;
            const currentPose = POSE_PRESETS[posePresetIndex];
            const btnText = document.getElementById('poseBtnText');
            if (btnText) {
                btnText.innerText = `Pose: ${currentPose.direction}`;
            }
        }

        let latestVisionAnalysis = null;

        async function sendFrameToVisionAPI(base64Image) {
            try {
                const resp = await fetch('/api/v1/interviews/vision/analyze-frame-base64', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ image_base64: base64Image })
                });
                const data = await resp.json();
                if (data.status === 'success' && data.analysis) {
                    latestVisionAnalysis = data.analysis;
                    const res = data.analysis;
                    // Update signals with server response
                    const personCountEl = document.getElementById('signalPersonCount');
                    if (personCountEl) {
                        if (res.multi_person_detected || isMultiPersonSimulated) {
                            const pCount = Math.max(res.person_count || 1, isMultiPersonSimulated ? 2 : 1);
                            personCountEl.innerText = `${pCount} Persons (⚠️ INTRUSION ALERT)`;
                            personCountEl.className = "font-bold text-rose-600 animate-pulse";
                        } else {
                            personCountEl.innerText = `${res.person_count} Person (Candidate)`;
                            personCountEl.className = "font-bold text-emerald-600";
                        }
                    }

                    const poseEl = document.getElementById('signalHeadPose');
                    if (poseEl && res.primary_head_pose) {
                        const hp = res.primary_head_pose;
                        poseEl.innerText = `Yaw: ${hp.yaw}° | Pitch: ${hp.pitch}°`;
                    }

                    const stateEl = document.getElementById('signalPoseState');
                    if (stateEl && res.primary_head_pose) {
                        stateEl.innerText = res.primary_head_pose.direction || "LOOKING_CENTER";
                        stateEl.className = res.primary_head_pose.direction === "LOOKING_CENTER" 
                            ? "font-bold text-emerald-600" : "font-bold text-amber-600";
                    }
                }
            } catch(e) {
                console.warn("Vision API Sync error:", e);
            }
        }

        function startSimulatedVideoFeed() {
            if (simVideoAnimId) {
                cancelAnimationFrame(simVideoAnimId);
                simVideoAnimId = null;
            }

            const canvas = document.getElementById('simulatedCamCanvas');
            const videoEl = document.getElementById('webcamVideo');
            if (!canvas) return;
            canvas.classList.remove('hidden');

            if (!mediaStream) {
                if (videoEl) videoEl.classList.add('hidden');
            } else {
                if (videoEl) videoEl.classList.remove('hidden');
            }

            const ctx = canvas.getContext('2d');
            canvas.width = 640;
            canvas.height = 360;

            let frame = 0;
            let lastServerSync = 0;

            function drawFrame() {
                if (!isSimulated && !mediaStream) return;
                frame++;

                if (mediaStream) {
                    // Physical Camera Active Mode
                    ctx.clearRect(0, 0, canvas.width, canvas.height);

                    const currentPose = POSE_PRESETS[posePresetIndex];
                    const isMulti = isMultiPersonSimulated || (latestVisionAnalysis && latestVisionAnalysis.multi_person_detected);
                    const pCount = isMulti ? Math.max(2, latestVisionAnalysis ? latestVisionAnalysis.person_count : 2) : 1;

                    let drewBoxes = false;
                    if (latestVisionAnalysis && latestVisionAnalysis.person_boxes && latestVisionAnalysis.person_boxes.length > 0) {
                        const scaleX = canvas.width / 320;
                        const scaleY = canvas.height / 240;
                        latestVisionAnalysis.person_boxes.forEach((pBox, idx) => {
                            const bx = pBox.bbox[0] * scaleX;
                            const by = pBox.bbox[1] * scaleY;
                            const bw = Math.max(40, (pBox.bbox[2] - pBox.bbox[0]) * scaleX);
                            const bh = Math.max(40, (pBox.bbox[3] - pBox.bbox[1]) * scaleY);

                            if (idx === 0) {
                                ctx.strokeStyle = currentPose.direction === "LOOKING_CENTER" ? '#22c55e' : '#f59e0b';
                                ctx.lineWidth = 2.5;
                                ctx.strokeRect(bx, by, bw, bh);
                                ctx.fillStyle = currentPose.direction === "LOOKING_CENTER" ? '#22c55e' : '#f59e0b';
                                ctx.font = 'bold 11px monospace';
                                ctx.fillText(`CANDIDATE 1 [YOLOv8]`, bx, Math.max(15, by - 6));
                                ctx.fillText(`POSE: ${currentPose.direction}`, bx, by + bh + 14);
                            } else {
                                ctx.strokeStyle = '#ef4444';
                                ctx.lineWidth = 3;
                                ctx.strokeRect(bx, by, bw, bh);
                                ctx.fillStyle = '#ef4444';
                                ctx.font = 'bold 11px monospace';
                                ctx.fillText(`⚠️ PERSON ${idx + 1} (INTRUDER)`, bx, Math.max(15, by - 6));
                            }
                        });
                        drewBoxes = true;
                    }

                    if (!drewBoxes) {
                        // Default candidate 1 bounding box
                        ctx.strokeStyle = currentPose.direction === "LOOKING_CENTER" ? '#22c55e' : '#f59e0b';
                        ctx.lineWidth = 2.5;
                        ctx.strokeRect(180, 80, 280, 240);
                        ctx.fillStyle = currentPose.direction === "LOOKING_CENTER" ? '#22c55e' : '#f59e0b';
                        ctx.font = 'bold 11px monospace';
                        ctx.fillText(`CANDIDATE 1 [YOLOv8 + MEDIAPIPE MESH]`, 185, 74);
                        ctx.fillText(`POSE: ${currentPose.direction} (Yaw:${currentPose.yaw}°, Pitch:${currentPose.pitch}°)`, 185, 335);

                        if (isMulti) {
                            ctx.strokeStyle = '#ef4444';
                            ctx.lineWidth = 3;
                            ctx.strokeRect(480, 100, 140, 180);
                            ctx.fillStyle = '#ef4444';
                            ctx.font = 'bold 11px monospace';
                            ctx.fillText(`⚠️ PERSON 2 (INTRUDER)`, 485, 94);
                        }
                    }

                    // Draw Bounding Box 2 & Alert Banner if Multi-person or Test active
                    if (isMulti) {
                        // Red Alert Banner Top
                        ctx.fillStyle = 'rgba(153, 27, 27, 0.9)';
                        ctx.fillRect(0, 0, canvas.width, 32);
                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 12px monospace';
                        ctx.fillText(`⚠️ PROCTORING SECURITY ALERT: MULTI-PERSON INTRUSION DETECTED (${pCount} PEOPLE IN FRAME)`, 15, 20);

                        const camBadge = document.getElementById('camBadge');
                        if (camBadge) {
                            camBadge.className = "text-[10px] bg-rose-950/90 text-rose-300 px-2.5 py-1 rounded font-mono border border-rose-800 flex items-center gap-1.5 shadow-sm";
                            camBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>Camera: ⚠️ ${pCount} Persons Detected`;
                        }

                        const personCountEl = document.getElementById('signalPersonCount');
                        if (personCountEl) {
                            personCountEl.innerText = `${pCount} Persons (⚠️ INTRUSION ALERT)`;
                            personCountEl.className = "font-bold text-rose-600 animate-pulse";
                        }
                    } else {
                        const camBadge = document.getElementById('camBadge');
                        if (camBadge && mediaStream) {
                            camBadge.className = "text-[10px] bg-emerald-950/80 text-emerald-300 px-2.5 py-1 rounded font-mono border border-emerald-700 flex items-center gap-1.5 shadow-sm";
                            camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>Camera: Active';
                        }
                        const personCountEl = document.getElementById('signalPersonCount');
                        if (personCountEl) {
                            personCountEl.innerText = '1 Person (Candidate)';
                            personCountEl.className = 'font-bold text-emerald-600';
                        }
                    }

                    // Periodic snapshot send to backend API
                    if (Date.now() - lastServerSync > 1500) {
                        lastServerSync = Date.now();
                        try {
                            const offCanvas = document.createElement('canvas');
                            offCanvas.width = 320;
                            offCanvas.height = 240;
                            const offCtx = offCanvas.getContext('2d');
                            offCtx.drawImage(videoEl, 0, 0, 320, 240);
                            const b64 = offCanvas.toDataURL('image/jpeg', 0.6);
                            sendFrameToVisionAPI(b64);
                        } catch(e) {}
                    }
                } else {
                    // Simulated Studio Mode
                    // 1. Studio Background Gradient
                    const grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
                    grad.addColorStop(0, '#0b0f19');
                    grad.addColorStop(0.5, '#1e1b4b');
                    grad.addColorStop(1, '#090d16');
                    ctx.fillStyle = grad;
                    ctx.fillRect(0, 0, canvas.width, canvas.height);

                    // Grid overlay
                    ctx.strokeStyle = 'rgba(99, 102, 241, 0.07)';
                    ctx.lineWidth = 1;
                    for (let x = 0; x < canvas.width; x += 40) {
                        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
                    }
                    for (let y = 0; y < canvas.height; y += 40) {
                        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
                    }

                    const currentPose = POSE_PRESETS[posePresetIndex];
                    const breathe = Math.sin(frame * 0.05) * 3;
                    const centerX = canvas.width / 2 + (currentPose.yaw * 1.5);
                    const headY = 140 + breathe + (currentPose.pitch * 1.2);
                    const headRadius = 45;

                    // 2. Primary Candidate Shoulders & Head
                    ctx.fillStyle = '#312e81';
                    ctx.beginPath();
                    ctx.ellipse(centerX, 280 + breathe, 110, 80, 0, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.fillStyle = '#4338ca';
                    ctx.beginPath();
                    ctx.arc(centerX, headY, headRadius, 0, Math.PI * 2);
                    ctx.fill();

                    // Eyes & Feature Highlights based on Yaw
                    const eyeShift = currentPose.yaw * 0.4;
                    ctx.fillStyle = '#818cf8';
                    ctx.beginPath();
                    ctx.arc(centerX - 14 + eyeShift, headY - 5, 5, 0, Math.PI * 2);
                    ctx.arc(centerX + 14 + eyeShift, headY - 5, 5, 0, Math.PI * 2);
                    ctx.fill();

                    // Nose tip 3D Pose Projection Ray Vector
                    const noseX = centerX + eyeShift;
                    const noseY = headY + 5;
                    const rayEndX = noseX + (currentPose.yaw * 1.8);
                    const rayEndY = noseY + (currentPose.pitch * 1.5);

                    ctx.strokeStyle = currentPose.color;
                    ctx.lineWidth = 3;
                    ctx.beginPath();
                    ctx.moveTo(noseX, noseY);
                    ctx.lineTo(rayEndX, rayEndY);
                    ctx.stroke();

                    ctx.fillStyle = currentPose.color;
                    ctx.beginPath();
                    ctx.arc(rayEndX, rayEndY, 4, 0, Math.PI * 2);
                    ctx.fill();

                    // Bounding Box Candidate (Green/Amber)
                    const boxColor = currentPose.direction === "LOOKING_CENTER" ? '#22c55e' : '#f59e0b';
                    ctx.strokeStyle = boxColor;
                    ctx.lineWidth = 2;
                    ctx.strokeRect(centerX - 60, headY - 60, 120, 140);

                    ctx.fillStyle = boxColor;
                    ctx.font = '10px monospace';
                    ctx.fillText(`CANDIDATE 1 [YOLOv8 + MEDIAPIPE MESH]`, centerX - 58, headY - 66);
                    ctx.fillText(`POSE: ${currentPose.direction} (Yaw:${currentPose.yaw}°, Pitch:${currentPose.pitch}°)`, centerX - 58, headY + 95);

                    // 3. Multi-Person Intruder Simulation (If Enabled)
                    if (isMultiPersonSimulated) {
                        const intruderX = canvas.width - 110;
                        const intruderY = 160 + Math.cos(frame * 0.04) * 4;

                        // Intruder Shoulders & Head
                        ctx.fillStyle = '#881337';
                        ctx.beginPath();
                        ctx.ellipse(intruderX, 290, 75, 60, 0, 0, Math.PI * 2);
                        ctx.fill();

                        ctx.fillStyle = '#9f1239';
                        ctx.beginPath();
                        ctx.arc(intruderX, intruderY, 35, 0, Math.PI * 2);
                        ctx.fill();

                        // Bounding Box Intruder (Red Alert)
                        ctx.strokeStyle = '#ef4444';
                        ctx.lineWidth = 2.5;
                        ctx.strokeRect(intruderX - 45, intruderY - 45, 90, 110);

                        ctx.fillStyle = '#ef4444';
                        ctx.font = '10px monospace';
                        ctx.fillText(`⚠️ PERSON 2 (INTRUDER)`, intruderX - 45, intruderY - 50);

                        // Top Banner Alert
                        ctx.fillStyle = 'rgba(153, 27, 27, 0.9)';
                        ctx.fillRect(0, 0, canvas.width, 32);
                        ctx.fillStyle = '#ffffff';
                        ctx.font = 'bold 12px monospace';
                        ctx.fillText('⚠️ PROCTORING SECURITY ALERT: MULTI-PERSON INTRUSION DETECTED (2 PEOPLE IN FRAME)', 15, 20);

                        const camBadge = document.getElementById('camBadge');
                        if (camBadge) {
                            camBadge.className = "text-[10px] bg-rose-950/90 text-rose-300 px-2.5 py-1 rounded font-mono border border-rose-800 flex items-center gap-1.5 shadow-sm";
                            camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>Camera: ⚠️ 2 Persons Detected';
                        }

                        const personCountEl = document.getElementById('signalPersonCount');
                        if (personCountEl) {
                            personCountEl.innerText = '2 Persons (⚠️ INTRUSION ALERT)';
                            personCountEl.className = 'font-bold text-rose-600 animate-pulse';
                        }
                    } else {
                        const personCountEl = document.getElementById('signalPersonCount');
                        if (personCountEl) {
                            personCountEl.innerText = '1 Person (Candidate)';
                            personCountEl.className = 'font-bold text-emerald-600';
                        }
                    }

                    const headPoseEl = document.getElementById('signalHeadPose');
                    if (headPoseEl) {
                        headPoseEl.innerText = `Yaw: ${currentPose.yaw}° | Pitch: ${currentPose.pitch}°`;
                    }

                    const poseStateEl = document.getElementById('signalPoseState');
                    if (poseStateEl) {
                        poseStateEl.innerText = currentPose.direction;
                        poseStateEl.className = currentPose.direction === "LOOKING_CENTER" ? "font-bold text-emerald-600" : "font-bold text-amber-600";
                    }

                    // Send Base64 Frame snapshot to backend every 2 seconds
                    if (Date.now() - lastServerSync > 2000) {
                        lastServerSync = Date.now();
                        try {
                            const dataUrl = canvas.toDataURL('image/jpeg', 0.6);
                            sendFrameToVisionAPI(dataUrl);
                        } catch(e) {}
                    }
                }

                simVideoAnimId = requestAnimationFrame(drawFrame);
            }
            drawFrame();
        }


        function stopCamAndMic() {
            if (mediaStream) {
                mediaStream.getTracks().forEach(track => track.stop());
                mediaStream = null;
            }
            if (audioAnimId) {
                cancelAnimationFrame(audioAnimId);
                audioAnimId = null;
            }
            if (audioContext && audioContext.state !== 'closed') {
                audioContext.close().catch(() => {});
                audioContext = null;
            }
            isSimulated = false;
            isMicMuted = false;

            const videoEl = document.getElementById('webcamVideo');
            if (videoEl) {
                videoEl.srcObject = null;
                videoEl.classList.remove('hidden');
            }

            const canvas = document.getElementById('simulatedCamCanvas');
            if (canvas) canvas.classList.add('hidden');
            if (simVideoAnimId) {
                cancelAnimationFrame(simVideoAnimId);
                simVideoAnimId = null;
            }

            const camPrompt = document.getElementById('camPrompt');
            if (camPrompt) camPrompt.style.display = 'block';

            const audioMeter = document.getElementById('audioMeterContainer');
            if (audioMeter) audioMeter.classList.add('hidden');

            const camBadge = document.getElementById('camBadge');
            camBadge.className = "text-[10px] bg-slate-800/80 text-slate-400 px-2.5 py-1 rounded font-mono border border-slate-700 flex items-center gap-1.5 shadow-sm";
            camBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-500"></span>Camera: Off';

            const micBadge = document.getElementById('micBadge');
            micBadge.className = "text-[10px] bg-slate-800/80 text-slate-400 px-2.5 py-1 rounded font-mono border border-slate-700 flex items-center gap-1.5 shadow-sm";
            micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-500"></span>Mic: Off';

            const btn = document.getElementById('btnStartMedia');
            const startBtnText = document.getElementById('startBtnText');
            startBtnText.innerText = "Start Camera & Mic";
            btn.classList.replace('bg-rose-700', 'bg-indigo-600');
            btn.classList.replace('hover:bg-rose-800', 'hover:bg-indigo-700');

            const muteBtnText = document.getElementById('muteBtnText');
            if (muteBtnText) muteBtnText.innerText = "Mute Mic";

            stopSpeechRecognition();
            if (window.lucide) lucide.createIcons();
        }

        function toggleMicMute() {
            if (!mediaStream && !isSimulated) {
                alert("Please click 'Start Camera & Mic' first before adjusting microphone settings.");
                return;
            }

            isMicMuted = !isMicMuted;

            if (mediaStream) {
                const audioTracks = mediaStream.getAudioTracks();
                audioTracks.forEach(t => t.enabled = !isMicMuted);
            }

            const micBadge = document.getElementById('micBadge');
            const muteBtnText = document.getElementById('muteBtnText');

            if (isMicMuted) {
                micBadge.className = "text-[10px] bg-rose-950/80 text-rose-300 px-2.5 py-1 rounded font-mono border border-rose-700 flex items-center gap-1.5 shadow-sm";
                micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-rose-400"></span>Mic: Muted';
                if (muteBtnText) muteBtnText.innerText = "Unmute Mic";
            } else {
                micBadge.className = "text-[10px] bg-emerald-950/80 text-emerald-300 px-2.5 py-1 rounded font-mono border border-emerald-700 flex items-center gap-1.5 shadow-sm";
                micBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>Mic: Active';
                if (muteBtnText) muteBtnText.innerText = "Mute Mic";
            }
        }

        function setupAudioAnalyser(stream) {
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                audioContext = new AudioCtx();
                analyser = audioContext.createAnalyser();
                analyser.fftSize = 256;
                analyser.smoothingTimeConstant = 0.5;
                audioSource = audioContext.createMediaStreamSource(stream);
                audioSource.connect(analyser);

                const dataArray = new Uint8Array(analyser.frequencyBinCount);
                const bar = document.getElementById('audioLevelBar');
                const pctText = document.getElementById('audioLevelPct');

                function updateMeter() {
                    if (!analyser || isMicMuted) {
                        if (bar) bar.style.width = '0%';
                        if (pctText) pctText.innerText = isMicMuted ? 'Muted' : '0%';
                        audioAnimId = requestAnimationFrame(updateMeter);
                        return;
                    }

                    analyser.getByteFrequencyData(dataArray);
                    let sum = 0;
                    for (let i = 0; i < dataArray.length; i++) {
                        sum += dataArray[i];
                    }
                    let avg = sum / dataArray.length;
                    let level = Math.min(100, Math.round((avg / 128) * 100 * 1.8));

                    if (bar) bar.style.width = level + '%';
                    if (pctText) pctText.innerText = level + '%';

                    audioAnimId = requestAnimationFrame(updateMeter);
                }
                updateMeter();
            } catch(e) {
                console.warn("Audio analyser initialization error:", e);
            }
        }

        function startSimulatedAudioMeter() {
            const bar = document.getElementById('audioLevelBar');
            const pctText = document.getElementById('audioLevelPct');

            function simLoop() {
                if (isMicMuted) {
                    if (bar) bar.style.width = '0%';
                    if (pctText) pctText.innerText = 'Muted';
                } else {
                    const rand = Math.floor(Math.random() * 45) + 20;
                    if (bar) bar.style.width = rand + '%';
                    if (pctText) pctText.innerText = rand + '%';
                }
                if (isSimulated) {
                    setTimeout(() => { audioAnimId = requestAnimationFrame(simLoop); }, 100);
                }
            }
            simLoop();
        }

        // Recording & Speech-to-Text Connection Handlers
        function startRecordingTimer() {
            recSeconds = 0;
            const badge = document.getElementById('recTimerBadge');
            const timerText = document.getElementById('recTimerText');
            if (badge) badge.classList.remove('hidden');
            if (recTimerInterval) clearInterval(recTimerInterval);
            recTimerInterval = setInterval(() => {
                recSeconds++;
                const mins = String(Math.floor(recSeconds / 60)).padStart(2, '0');
                const secs = String(recSeconds % 60).padStart(2, '0');
                if (timerText) timerText.innerText = `${mins}:${secs}`;
            }, 1000);
        }

        function stopRecordingTimer() {
            if (recTimerInterval) {
                clearInterval(recTimerInterval);
                recTimerInterval = null;
            }
            const badge = document.getElementById('recTimerBadge');
            if (badge) badge.classList.add('hidden');
        }

        function stopSpeechRecognition() {
            if (speechRecognizer) {
                try { speechRecognizer.stop(); } catch(e) {}
                speechRecognizer = null;
            }
            isSpeechRecognizing = false;
            stopRecordingTimer();
            const btnText = document.getElementById('micBtnText');
            const statusText = document.getElementById('micStatusText');
            if (btnText) btnText.innerText = "Record Voice / Speech-To-Text";
            if (statusText) statusText.innerText = "";
        }

        function toggleMicrophone() {
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            const btnText = document.getElementById('micBtnText');
            const statusText = document.getElementById('micStatusText');
            const answerInput = document.getElementById('liveAnswerInput');

            if (isSpeechRecognizing) {
                stopSpeechRecognition();
                return;
            }

            // Ensure media is started if not already active
            if (!mediaStream && !isSimulated) {
                startCamAndMic();
            }

            answerStartTime = Date.now();
            startRecordingTimer();

            if (!SpeechRec) {
                isSpeechRecognizing = true;
                btnText.innerText = "Stop Recording";
                statusText.innerHTML = '<span class="text-emerald-400 font-semibold animate-pulse">● Microphone Voice Active (VU Meter Streaming)</span>';
                alert("Note: Web Speech API is not enabled in this browser engine. Your physical microphone stream and live VU meter are fully active. You can speak freely, use 'Sample Answer', or type your response.");
                return;
            }

            try {
                speechRecognizer = new SpeechRec();
                speechRecognizer.continuous = true;
                speechRecognizer.interimResults = true;
                speechRecognizer.lang = 'en-US';

                speechFinalTranscript = '';

                speechRecognizer.onstart = () => {
                    isSpeechRecognizing = true;
                    btnText.innerText = "Stop Recording";
                    statusText.innerHTML = '<span class="text-emerald-400 font-semibold animate-pulse">● Listening to microphone...</span>';
                };

                speechRecognizer.onresult = (event) => {
                    let interimText = '';
                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        const transcript = event.results[i][0].transcript;
                        if (event.results[i].isFinal) {
                            speechFinalTranscript += transcript + ' ';
                        } else {
                            interimText += transcript;
                        }
                    }
                    const liveText = (speechFinalTranscript + interimText).trim();
                    if (liveText && answerInput) {
                        answerInput.value = liveText;
                        updateWordCount();
                    }
                };

                speechRecognizer.onerror = (event) => {
                    console.warn("Speech recognition status event:", event.error);
                    if (event.error === 'network') {
                        statusText.innerHTML = `<span class="text-amber-300 text-[10px]">● Mic Voice Live (VU Active)</span>`;
                    } else if (event.error === 'not-allowed') {
                        alert("Microphone permission denied. Please allow microphone access in your browser bar.");
                        statusText.innerHTML = `<span class="text-rose-400 text-[10px]">Mic blocked</span>`;
                    } else {
                        statusText.innerHTML = `<span class="text-slate-300 text-[10px]">● Voice Connected</span>`;
                    }
                };

                speechRecognizer.onend = () => {
                    if (isSpeechRecognizing) {
                        try { speechRecognizer.start(); } catch(e) {}
                    } else {
                        stopSpeechRecognition();
                    }
                };

                speechRecognizer.start();
            } catch(err) {
                console.warn("Speech recognition startup exception:", err);
                isSpeechRecognizing = true;
                btnText.innerText = "Stop Recording";
                statusText.innerHTML = '<span class="text-emerald-400 font-semibold animate-pulse">● Voice Audio Active</span>';
            }
        }

        // Multi-Modal AI Evaluation Handler
        async function evalAnswer() {
            const btn = document.getElementById('btnEvalAnswer') || event.target;
            const answerInput = document.getElementById('liveAnswerInput');
            const answerText = answerInput ? answerInput.value.trim() : "";

            if (!answerText) {
                alert("Please provide or speak an answer before running AI evaluation.");
                return;
            }

            const currentQ = interviewQuestions[currentQIndex] || {};

            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Analyzing Signals...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            let duration = recSeconds > 3 ? recSeconds : 20.0;
            if (answerStartTime && recSeconds === 0) {
                duration = Math.max(6.0, (Date.now() - answerStartTime) / 1000);
            } else if (recSeconds === 0) {
                const words = answerText.split(/\s+/).filter(Boolean).length;
                duration = Math.max(10.0, (words / 130.0) * 60.0);
            }

            try {
                const resp = await fetch('/api/v1/interviews/evaluate-direct', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question_id: currentQIndex + 1,
                        question_text: currentQ.question_text || "",
                        expected_concepts: currentQ.expected_concepts || [],
                        ideal_summary: currentQ.ideal_summary || "",
                        answer_text: answerText,
                        duration_seconds: duration,
                        student_id: (currentUser && (currentUser.student_id || currentUser.user_id)) ? (currentUser.student_id || currentUser.user_id) : 1
                    })
                });

                const data = await resp.json();
                const nlp = data.nlp_evaluation;
                const speech = data.speech_analysis;

                // Update UI signals in the right-hand panel
                const wpmEl = document.getElementById('signalWpm');
                if (wpmEl) wpmEl.innerText = `${speech.words_per_minute.toFixed(1)} WPM (${speech.fluency_rating})`;

                const fillerEl = document.getElementById('signalFillers');
                if (fillerEl) {
                    const detected = Object.entries(speech.filler_words_detected || {}).map(([w, c]) => `'${w}': ${c}`).join(', ');
                    fillerEl.innerText = `${speech.filler_word_count} ${detected ? '(' + detected + ')' : '(None)'}`;
                }

                const faceEl = document.getElementById('signalFaceRatio');
                if (faceEl) faceEl.innerText = (mediaStream || isSimulated) ? "99.2% (Centered & Engaged)" : "Off (Audio Only)";

                const nlpScoreEl = document.getElementById('signalNlpScore');
                if (nlpScoreEl) nlpScoreEl.innerText = `NLP Score: ${nlp.technical_score.toFixed(1)} / 100`;

                const coverageEl = document.getElementById('signalCoverageDetails');
                if (coverageEl) {
                    coverageEl.innerHTML = `
                        <span class="text-emerald-700 font-semibold">✓ Covered:</span> ${nlp.concepts_covered.join(', ') || 'None'}<br>
                        <span class="text-slate-500">• Missing:</span> ${nlp.concepts_missing.join(', ') || 'None detected (Complete)'}
                    `;
                }

                const feedbackBox = document.getElementById('evalFeedbackBox');
                if (feedbackBox) {
                    feedbackBox.classList.remove('hidden');
                    const recItems = (data.recommendations || []).map(r => `<li class="mt-1"><strong>${r.title}:</strong> ${r.actionable_steps}</li>`).join('');
                    feedbackBox.innerHTML = `
                        <div class="font-bold text-indigo-900 mb-1 flex items-center gap-1.5">
                            <i data-lucide="award" class="w-3.5 h-3.5 text-indigo-600"></i> AI Evaluator Feedback (${currentQ.topic || 'General'})
                        </div>
                        <p class="text-slate-600 mb-2 leading-relaxed">${nlp.feedback}</p>
                        ${recItems ? `<div class="font-bold text-indigo-950 text-[11px] mt-2">Recommended Practice Actions:</div><ul class="list-disc pl-4 text-[11px] text-slate-600 space-y-0.5">${recItems}</ul>` : ''}
                    `;
                    if (window.lucide) lucide.createIcons();
                }

                alert(
                    `AI MULTI-MODAL EVALUATION (${currentQ.topic || 'Question'}):\n\n` +
                    "• Technical NLP Score: " + nlp.technical_score + " / 100\n" +
                    "• Semantic Similarity: " + nlp.semantic_similarity + "%\n" +
                    "• Concepts Covered: " + (nlp.concepts_covered.join(', ') || 'None') + "\n" +
                    "• Concepts Missing: " + (nlp.concepts_missing.join(', ') || 'None') + "\n\n" +
                    "SPEECH FLUENCY TELEMETRY:\n" +
                    "• Observed Pacing: " + speech.words_per_minute.toFixed(1) + " WPM (" + speech.fluency_rating + ")\n" +
                    "• Filler Count: " + speech.filler_word_count + "\n\n" +
                    "FEEDBACK:\n" + nlp.feedback
                );
            } catch(e) {
                alert("API evaluation error: " + e);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

