<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI-Powered Training & Placement Management System</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">
    <!-- Header -->
    <header class="bg-indigo-950 text-white shadow sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-indigo-600 rounded-lg"><i data-lucide="graduation-cap" class="w-6 h-6"></i></div>
                <div>
                    <span class="font-bold text-lg text-white block leading-tight">AI-TPMS Portal</span>
                    <span class="text-xs text-indigo-300">Intelligent Training & Placement Platform</span>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <span id="roleBadge" class="px-2.5 py-1 rounded bg-indigo-600 text-white font-mono text-[11px] font-bold shadow-sm">STUDENT</span>
                <div class="text-right hidden sm:block">
                    <span id="userDisplayName" class="text-xs font-bold text-white block leading-tight">Aditi Rao</span>
                    <span id="userEmailDisplay" class="text-[10px] text-indigo-300 block">aditi.rao@student.edu</span>
                </div>
                <button onclick="openLoginModal()" id="btnHeaderAuth" class="px-3.5 py-1.5 bg-indigo-700 hover:bg-indigo-600 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow">
                    <i data-lucide="log-in" class="w-3.5 h-3.5"></i>
                    <span id="headerAuthBtnText">Sign In / Switch Role</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full">
        <nav class="flex border-b border-slate-200 mb-8 space-x-6 overflow-x-auto">
            <button onclick="showTab('dashboard')" id="tab-dashboard" class="py-3 font-semibold text-sm border-b-2 border-indigo-600 text-indigo-600 whitespace-nowrap">Executive Dashboard</button>
            <button onclick="showTab('resume')" id="tab-resume" class="py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 whitespace-nowrap flex items-center gap-1.5">
                <i data-lucide="file-text" class="w-4 h-4 text-indigo-600"></i>
                <span>Resume Intelligence & Selection Pipeline</span>
            </button>
            <button onclick="showTab('interview')" id="tab-interview" class="py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 whitespace-nowrap flex items-center gap-1.5">
                <i data-lucide="video" class="w-4 h-4 text-emerald-600"></i>
                <span>AI Mock Interview & Camera Proctoring</span>
            </button>
            <button onclick="showTab('placement')" id="tab-placement" class="py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 whitespace-nowrap">Jobs & Eligibility</button>
            <button onclick="showTab('admin')" id="tab-admin" class="py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 whitespace-nowrap flex items-center gap-1.5 hidden">
                <i data-lucide="shield-check" class="w-4 h-4 text-purple-600"></i>
                <span>Admin & Proctoring</span>
            </button>
        </nav>

        <!-- View 1: Dashboard -->
        <div id="view-dashboard" class="space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-500 uppercase">Attendance</span>
                    <div class="mt-2"><span id="dashAttendanceVal" class="text-2xl font-bold">88.5%</span> <span id="dashAttendanceBadge" class="text-xs text-emerald-600 font-bold">Eligible</span></div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-500 uppercase">Technical Core</span>
                    <div class="mt-2"><span id="dashTechnicalVal" class="text-2xl font-bold">85.0%</span> <span id="dashTechnicalBadge" class="text-xs text-blue-600 font-bold">High</span></div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-500 uppercase">Mock Interview</span>
                    <div class="mt-2"><span id="dashInterviewVal" class="text-2xl font-bold">78.0/100</span> <span id="dashInterviewBadge" class="text-xs text-purple-600 font-bold">Evaluated</span></div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200">
                    <span class="text-xs font-bold text-slate-500 uppercase">Readiness Index</span>
                    <div class="mt-2"><span id="dashReadinessVal" class="text-2xl font-bold text-indigo-600">83.5%</span> <span id="dashReadinessBadge" class="text-xs text-emerald-600 font-bold">Placement Ready</span></div>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-white p-6 rounded-xl border border-slate-200">
                    <h3 class="font-bold text-sm mb-4">Competency Breakdown Radar</h3>
                    <div class="h-64"><canvas id="competencyChart"></canvas></div>
                </div>
                <div class="bg-white p-6 rounded-xl border border-slate-200 flex flex-col justify-between">
                    <div>
                        <h3 class="font-bold text-sm mb-2">Personalized Recommendations</h3>
                        <p class="text-xs text-slate-500 mb-4">Autonomous suggestions generated from assessment weak spots (<65%).</p>
                        <div class="p-3 bg-slate-50 rounded border border-slate-200">
                            <span class="text-xs font-bold text-indigo-900 block">Advanced System Design Polish</span>
                            <span class="text-xs text-slate-600">Scores meet thresholds. Focus on high-level architecture case studies.</span>
                        </div>
                    </div>
                    <button onclick="downloadMyReport()" class="mt-4 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded text-center transition flex items-center justify-center gap-1.5 cursor-pointer">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Download PDF Report</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- View 2: Resume Intelligence & Placement Selection Pipeline -->
        <div id="view-resume" class="bg-white p-6 rounded-xl border border-slate-200 space-y-6 hidden">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b pb-4 gap-3">
                <div>
                    <h2 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                        <i data-lucide="file-text" class="w-5 h-5 text-indigo-600"></i>
                        Resume Intelligence & Skill Parser
                    </h2>
                    <p class="text-xs text-slate-500 mt-1">Upload candidate resume or paste profile text to extract skills taxonomy and dynamically drive the 3-round selection pipeline.</p>
                </div>
                <button onclick="loadSampleResume('aditi')" class="px-3.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition self-start sm:self-auto border border-slate-200">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5 text-indigo-600"></i>
                    Load Aditi's Profile
                </button>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Resume Text & Upload Input -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                            <i data-lucide="edit-3" class="w-3.5 h-3.5 text-indigo-600"></i>
                            Candidate Resume / Profile Content:
                        </label>
                        <div class="flex items-center gap-2">
                            <button onclick="loadSampleResumeText()" type="button" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 transition flex items-center gap-1">
                                <i data-lucide="file-text" class="w-3 h-3"></i> Load Sample Resume
                            </button>
                            <span class="text-slate-300">|</span>
                            <button onclick="clearResumeText()" type="button" class="text-[11px] text-slate-400 hover:text-rose-600 transition">
                                Clear
                            </button>
                        </div>
                    </div>
                    <textarea id="resumeTextInput" rows="8" class="w-full text-xs p-3.5 bg-slate-50 text-slate-800 border border-slate-300 rounded-xl font-mono focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none leading-relaxed shadow-sm placeholder:text-slate-400 font-sans" placeholder="Paste your resume plain text here (including contact info, technical skills, projects, and education) or click 'Load Sample Resume' above to test with a verified profile..."></textarea>
                    
                    <div class="flex flex-wrap items-center gap-3">
                        <button onclick="runComprehensiveAtsAudit()" id="btnRunAtsAudit" class="px-5 py-2.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition shadow-sm cursor-pointer">
                            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-200"></i>
                            <span>Run Full ATS Quality Audit</span>
                        </button>
                        <button onclick="parseResumeLive()" id="btnParseResume" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-2 transition shadow-sm cursor-pointer">
                            <i data-lucide="cpu" class="w-4 h-4"></i>
                            <span>Extract Skills & Pipeline</span>
                        </button>
                        <label id="uploadFileLabel" class="px-4 py-2.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-semibold flex items-center gap-1.5 cursor-pointer transition shadow-sm">
                            <i data-lucide="upload" class="w-4 h-4 text-slate-500"></i>
                            <span>Upload Resume File (.txt/.pdf)</span>
                            <input type="file" id="resumeFileInput" accept=".txt,.pdf" class="hidden" onchange="handleResumeFileUpload(event)">
                        </label>
                    </div>
                </div>

                <!-- Skill Extraction & Adaptive Question Raiser Box -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 flex flex-col justify-between space-y-4">
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                                Normalized Technical Skills Taxonomy:
                            </span>
                            <span id="skillCountBadge" class="text-[11px] bg-indigo-100 text-indigo-800 px-2.5 py-0.5 rounded-full font-bold">5 Skills Detected</span>
                        </div>
                        <div id="skillsTagContainer" class="flex flex-wrap gap-2 min-h-[72px] p-3 bg-white rounded-xl border border-slate-200 shadow-inner">
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">Python</span>
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">FastAPI</span>
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">React</span>
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">SQL</span>
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-medium">Docker</span>
                        </div>
                        <p class="text-xs text-slate-500 leading-relaxed">
                            Our AI Question Raiser analyzes each normalized skill to generate specialized, resume-linked questions tailored to the candidate's exact technical profile.
                        </p>
                    </div>

                    <!-- Highlighted Action Button to Raise Questions -->
                    <div class="pt-3 border-t border-slate-200">
                        <button onclick="raiseQuestionsFromResume()" id="btnRaiseQuestions" class="w-full py-3.5 bg-gradient-to-r from-indigo-600 via-indigo-700 to-purple-700 hover:from-indigo-700 hover:to-purple-800 text-white rounded-xl text-sm font-bold flex items-center justify-center gap-2 shadow-lg transition transform active:scale-[0.99]">
                            <i data-lucide="zap" class="w-5 h-5 text-amber-300"></i>
                            <span>Extract Resume & Prepare 3-Round Selection Pipeline</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Comprehensive ATS Resume Health, Structure & Impact Audit -->
            <div id="atsAuditContainer" class="bg-white rounded-2xl p-6 border border-slate-200 shadow-md space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-gradient-to-br from-emerald-500 to-teal-600 text-white rounded-xl shadow">
                            <i data-lucide="shield-check" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-slate-900">Comprehensive ATS Quality, Formatting & Impact Audit</h3>
                            <p class="text-xs text-slate-500">Evaluates recruiter contact channels, section architecture, technical action verbs, and quantifiable metrics.</p>
                        </div>
                    </div>
                    <span id="auditGradeBadge" class="px-3 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold rounded-full font-mono flex items-center gap-1.5">
                        <i data-lucide="award" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span id="auditGradeBadgeText">GRADE A+ (86/100)</span>
                    </span>
                </div>

                <!-- Audit Metric Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                    <div class="p-4 bg-emerald-50/70 rounded-xl border border-emerald-200 text-center">
                        <span class="text-[11px] text-emerald-800 font-bold uppercase tracking-wider block">Overall ATS Score</span>
                        <span id="auditTotalScore" class="text-3xl font-black text-emerald-600">86/100</span>
                        <span id="auditStatusText" class="text-[11px] text-emerald-700 font-semibold block mt-1">ATS Optimized (Executive Ready)</span>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center">
                        <span class="text-[11px] text-slate-500 font-semibold block">Contact & Portfolio</span>
                        <span id="auditContactScore" class="text-2xl font-bold text-slate-800">25/25</span>
                        <span id="auditContactSummary" class="text-[11px] text-emerald-600 font-semibold block mt-1">Email • Phone • GitHub</span>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center">
                        <span class="text-[11px] text-slate-500 font-semibold block">Section Completeness</span>
                        <span id="auditSectionScore" class="text-2xl font-bold text-slate-800">25/25</span>
                        <span id="auditSectionSummary" class="text-[11px] text-emerald-600 font-semibold block mt-1">Skills • Projects • Education</span>
                    </div>
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center">
                        <span class="text-[11px] text-slate-500 font-semibold block">Action Verbs & Impact</span>
                        <span id="auditActionScore" class="text-2xl font-bold text-indigo-600">25/25</span>
                        <span id="auditActionSummary" class="text-[11px] text-indigo-600 font-semibold block mt-1">5 Active Verbs Found</span>
                    </div>
                </div>

                <!-- Highlights & Actionable Improvements -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div class="p-4 bg-emerald-50/40 rounded-xl border border-emerald-200 space-y-2">
                        <span class="font-bold text-emerald-900 flex items-center gap-1.5">
                            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                            ATS Verified Highlights & Strengths:
                        </span>
                        <ul id="auditStrengthsList" class="space-y-1 text-slate-700 pl-4 list-disc text-xs leading-relaxed">
                            <li>Direct recruiter contact channels (Email & Phone) detected.</li>
                            <li>Digital technical portfolio links (GitHub / LinkedIn) present.</li>
                            <li>Active leadership voice: Strong technical action verbs detected.</li>
                            <li>Quantifiable achievements and metrics included.</li>
                        </ul>
                    </div>
                    <div class="p-4 bg-amber-50/50 rounded-xl border border-amber-200 space-y-2">
                        <span class="font-bold text-amber-900 flex items-center gap-1.5">
                            <i data-lucide="lightbulb" class="w-4 h-4 text-amber-600"></i>
                            Actionable Resume Improvements:
                        </span>
                        <ul id="auditImprovementsList" class="space-y-1 text-slate-700 pl-4 list-disc text-xs leading-relaxed">
                            <li>Adopt the Google X-Y-Z formula: 'Accomplished [X] as measured by [Y] by doing [Z]'.</li>
                            <li>Ensure technical keywords match the exact naming in target job drives.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- ATS Resume & Job Description Skill-Gap Analyzer Section -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-md space-y-4">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 bg-gradient-to-br from-indigo-500 to-purple-600 text-white rounded-xl shadow">
                            <i data-lucide="scan-line" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-base text-slate-900">ATS Resume & Job Description Skill-Gap Analyzer</h3>
                            <p class="text-xs text-slate-500">Benchmark your resume skills against target campus recruitment job roles with TF-IDF semantic alignment.</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 bg-purple-50 text-purple-700 border border-purple-200 text-xs font-bold rounded-full font-mono">
                        ATS ENGINE v2.0
                    </span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="space-y-1.5 md:col-span-1">
                        <label class="text-xs font-bold text-slate-700">Target Campus Drive / Role:</label>
                        <select id="gapJobSelect" onchange="onGapJobSelectChange()" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-medium">
                            <option value="1">Cognitive Cloud Tech - Python Cloud Backend Engineer (14.5 LPA)</option>
                            <option value="2">Apex Quantum Systems - Full Stack Platform Engineer (12.0 LPA)</option>
                            <option value="3">Deloitte USI - Systems Integration Analyst (8.5 LPA)</option>
                            <option value="4">TCS Digital - Digital Software Engineer (7.5 LPA)</option>
                            <option value="custom">-- Custom Job Description (Enter Below) --</option>
                        </select>
                    </div>
                    <div class="space-y-1.5 md:col-span-2">
                        <label class="text-xs font-bold text-slate-700">Target Job Description (JD Text or Custom Criteria):</label>
                        <textarea id="gapJdInput" rows="2" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500 font-mono" placeholder="Select a job role above or paste custom JD requirements here...">Seeking Backend Engineer proficient in Python, FastAPI, Docker, SQL, Kubernetes, CI/CD, and Redis caching. Strong knowledge of REST APIs and data structures required.</textarea>
                    </div>
                </div>

                <div class="flex justify-end">
                    <button onclick="runAtsSkillGapAnalysis()" id="btnRunSkillGap" class="px-5 py-2.5 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white rounded-xl text-xs font-bold transition shadow flex items-center gap-2 cursor-pointer">
                        <i data-lucide="gauge" class="w-4 h-4"></i>
                        <span>Calculate ATS Compatibility & Skill Gaps</span>
                    </button>
                </div>

                <!-- Skill Gap Results Container (Hidden by default) -->
                <div id="gapResultContainer" class="hidden pt-4 border-t border-slate-100 space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
                            <span class="text-[11px] text-slate-500 font-medium block">ATS Match Score</span>
                            <span id="gapAtsScore" class="text-2xl font-black text-purple-600">--%</span>
                        </div>
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
                            <span class="text-[11px] text-slate-500 font-medium block">Keyword Match</span>
                            <span id="gapKeywordMatch" class="text-2xl font-black text-indigo-600">--%</span>
                        </div>
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
                            <span class="text-[11px] text-slate-500 font-medium block">Semantic Similarity</span>
                            <span id="gapSemanticSim" class="text-2xl font-black text-emerald-600">--%</span>
                        </div>
                        <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 text-center">
                            <span class="text-[11px] text-slate-500 font-medium block">ATS Verdict</span>
                            <span id="gapVerdict" class="text-xs font-bold text-slate-800 block mt-1">Pending</span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                        <!-- Matched Skills -->
                        <div class="p-4 bg-emerald-50/50 rounded-xl border border-emerald-200 space-y-2">
                            <div class="flex items-center justify-between font-bold text-emerald-900">
                                <span class="flex items-center gap-1.5"><i data-lucide="check-circle" class="w-4 h-4 text-emerald-600"></i> Matched Verified Skills</span>
                                <span id="gapMatchedCount" class="px-2 py-0.5 bg-emerald-200 text-emerald-800 rounded-full text-[10px]">0</span>
                            </div>
                            <div id="gapMatchedPills" class="flex flex-wrap gap-1.5 min-h-[36px]"></div>
                        </div>

                        <!-- Missing Skills -->
                        <div class="p-4 bg-rose-50/50 rounded-xl border border-rose-200 space-y-2">
                            <div class="flex items-center justify-between font-bold text-rose-900">
                                <span class="flex items-center gap-1.5"><i data-lucide="alert-triangle" class="w-4 h-4 text-rose-600"></i> Critical Deficit Skills</span>
                                <span id="gapMissingCount" class="px-2 py-0.5 bg-rose-200 text-rose-800 rounded-full text-[10px]">0</span>
                            </div>
                            <div id="gapMissingPills" class="flex flex-wrap gap-1.5 min-h-[36px]"></div>
                        </div>
                    </div>

                    <!-- Actionable Recommendations & X-Y-Z Rewrite Advice -->
                    <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                        <span class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                            <i data-lucide="lightbulb" class="w-4 h-4 text-amber-500"></i>
                            Actionable Resume Optimization & X-Y-Z Bullet Point Recommendations:
                        </span>
                        <div id="gapRecommendations" class="space-y-1.5 text-xs text-slate-600"></div>
                    </div>
                </div>
            </div>

            <!-- EMBEDDED SEQUENTIAL 3-ROUND PLACEMENT RECRUITMENT PIPELINE -->
            <div class="pt-6 border-t border-slate-200 space-y-6">
                <!-- Header Banner -->
                <div class="bg-gradient-to-r from-slate-900 via-emerald-950 to-slate-900 text-white p-6 rounded-2xl border border-emerald-900/50 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="bg-emerald-600 text-emerald-100 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">Sequential Placement Selection Pipeline</span>
                            <span id="pipelineStatusBadge" class="text-emerald-300 text-xs font-mono font-bold">Resume Verified • Round 1 Ready</span>
                        </div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i data-lucide="layers" class="w-6 h-6 text-emerald-400"></i>
                            Resume-First Order-Wise Recruitment Drives Workflow
                        </h2>
                        <p class="text-xs text-slate-300 mt-1 max-w-2xl">Execute selection rounds in order: **Step 0: Resume Entry** $\rightarrow$ **Round 1: Aptitude (10 Qs)** $\rightarrow$ **Round 2: Technical (10 Qs Resume-Tailored)** $\rightarrow$ **Round 3: Mock AI Interview (Resume Adaptive)**.</p>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <button onclick="resetSequentialPipeline()" class="px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl border border-slate-700 transition flex items-center gap-1.5 shadow">
                            <i data-lucide="rotate-ccw" class="w-4 h-4 text-amber-400"></i>
                            <span>Reset / Start Fresh</span>
                        </button>
                        <button onclick="loadSequentialPipelineWorkflow()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-2 shadow">
                            <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                            <span>Refresh Status</span>
                        </button>
                        <button onclick="downloadMyReport()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-2 shadow cursor-pointer">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span>Download PDF Report</span>
                        </button>
                    </div>
                </div>

                <!-- Stepper Progress Banner -->
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4 font-semibold text-xs">
                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <div id="step0Indicator" class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold font-mono">0</div>
                        <div>
                            <span class="text-slate-900 block font-bold">0. Resume Entry</span>
                            <span class="text-[11px] text-emerald-600 font-bold">✓ Verified</span>
                        </div>
                    </div>
                    <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400 hidden md:block"></i>

                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <div id="step1Indicator" class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold font-mono">1</div>
                        <div>
                            <span class="text-slate-900 block font-bold">1. Aptitude Round</span>
                            <span class="text-[11px] text-slate-500 font-normal">10 MCQs (Quant & Logic)</span>
                        </div>
                    </div>
                    <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400 hidden md:block"></i>

                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <div id="step2Indicator" class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold font-mono">2</div>
                        <div>
                            <span class="text-slate-900 block font-bold">2. Technical Round</span>
                            <span class="text-[11px] text-slate-500 font-normal">10 MCQs (Resume Skill Tailored)</span>
                        </div>
                    </div>
                    <i data-lucide="arrow-right" class="w-4 h-4 text-slate-400 hidden md:block"></i>

                    <div class="flex items-center gap-3 w-full md:w-auto">
                        <div id="step3Indicator" class="w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold font-mono">3</div>
                        <div>
                            <span class="text-slate-900 block font-bold">3. Mock AI Interview</span>
                            <span class="text-[11px] text-slate-500 font-normal">Voice STT + Resume Adaptive</span>
                        </div>
                    </div>
                </div>

                <!-- 3 Round Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Card 1: Aptitude Round -->
                    <div id="cardRound1" class="bg-white p-6 rounded-2xl border-2 border-emerald-500 shadow-md flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full uppercase tracking-wider font-mono">Round 1</span>
                                <span id="round1StatusTag" class="text-xs font-bold text-emerald-600 flex items-center gap-1"><i data-lucide="play-circle" class="w-4 h-4"></i> Ready to Start</span>
                            </div>
                            <h3 class="font-bold text-base text-slate-900">General Aptitude & Logical Reasoning</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">Quantitative Aptitude, Logical Reasoning, Time & Work, Interest, Probability & Verbal Ability (10 MCQs, Cutoff 60%).</p>
                            
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1 text-xs">
                                <div class="flex justify-between text-slate-600"><span>Questions:</span> <strong>10 MCQs (100 Marks)</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Duration:</span> <strong>30 Mins</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Cutoff Score:</span> <strong>60.0%</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Your Score:</span> <strong id="scoreRound1Text" class="text-indigo-600">--</strong></div>
                            </div>
                        </div>
                        <button id="btnStartRound1" onclick="openRoundTestModal(1, 'Round 1: General Aptitude & Logical Reasoning (10 Questions)')" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2">
                            <i data-lucide="check-square" class="w-4 h-4"></i>
                            <span>Start Round 1: Aptitude Test (10 Qs)</span>
                        </button>
                    </div>

                    <!-- Card 2: Technical Round -->
                    <div id="cardRound2" class="bg-white p-6 rounded-2xl border border-slate-200 opacity-80 shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-[10px] font-bold rounded-full uppercase tracking-wider font-mono">Round 2</span>
                                <span id="round2StatusTag" class="text-xs font-bold text-slate-500 flex items-center gap-1"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Locked (Clear R1 First)</span>
                            </div>
                            <h3 class="font-bold text-base text-slate-900">Technical & Coding (Resume-Tailored)</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">Questions dynamically generated from candidate's extracted Resume Skills: Python, FastAPI, React, SQL, Docker & System Design (10 MCQs, Cutoff 65%).</p>
                            
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1 text-xs">
                                <div class="flex justify-between text-slate-600"><span>Questions:</span> <strong>10 MCQs (100 Marks)</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Duration:</span> <strong>45 Mins</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Cutoff Score:</span> <strong>65.0%</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Your Score:</span> <strong id="scoreRound2Text" class="text-indigo-600">--</strong></div>
                            </div>
                        </div>
                        <button id="btnStartRound2" disabled onclick="openRoundTestModal(2, 'Round 2: Technical & Coding Knowledge Assessment (10 Questions - Resume Tailored)')" class="w-full py-3 bg-slate-300 text-slate-600 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 cursor-not-allowed">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                            <span>Round 2 Locked (Clear R1)</span>
                        </button>
                    </div>

                    <!-- Card 3: AI Interview Round -->
                    <div id="cardRound3" class="bg-white p-6 rounded-2xl border border-slate-200 opacity-80 shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-[10px] font-bold rounded-full uppercase tracking-wider font-mono">Round 3</span>
                                <span id="round3StatusTag" class="text-xs font-bold text-slate-500 flex items-center gap-1"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Locked (Clear R2 First)</span>
                            </div>
                            <h3 class="font-bold text-base text-slate-900">Mock AI Video & Voice Interview</h3>
                            <p class="text-xs text-slate-600 leading-relaxed">Live multi-modal video evaluation with Voice STT, MediaPipe 3D Head Pose tracking, and YOLOv8 proctoring based on raised Resume Questions (Cutoff 70%).</p>
                            
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1 text-xs">
                                <div class="flex justify-between text-slate-600"><span>Duration:</span> <strong>20 Mins</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Cutoff Score:</span> <strong>70.0%</strong></div>
                                <div class="flex justify-between text-slate-600"><span>Your Score:</span> <strong id="scoreRound3Text" class="text-indigo-600">--</strong></div>
                            </div>
                        </div>
                        <button id="btnStartRound3" disabled onclick="showTab('interview')" class="w-full py-3 bg-slate-300 text-slate-600 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 cursor-not-allowed">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                            <span>Round 3 Locked (Clear R2)</span>
                        </button>
                    </div>
                </div>

                <!-- Inline Assessment Interactive Container -->
                <div id="inlineTestSection" class="mt-6 bg-white p-6 rounded-2xl border-2 border-indigo-600 shadow-xl space-y-6 hidden transition-all">
                    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
                        <div class="space-y-1">
                            <span class="px-2.5 py-1 bg-indigo-100 text-indigo-800 text-[10px] font-bold rounded-full uppercase tracking-wider font-mono">LIVE SELECTION ASSESSMENT</span>
                            <h3 id="inlineTestTitle" class="font-bold text-lg text-slate-900">Round 1: General Aptitude & Logical Reasoning (10 MCQs)</h3>
                            <p class="text-xs text-slate-500">Read each question carefully and select the correct answer. Total Marks: 100 | Cutoff: 60%</p>
                        </div>
                        <button onclick="closeInlineTestSection()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition flex items-center gap-1.5">
                            <i data-lucide="x" class="w-4 h-4"></i>
                            <span>Close Test View</span>
                        </button>
                    </div>

                    <form id="inlineTestForm" onsubmit="submitInlineTestAssessment(event)" class="space-y-6">
                        <div id="inlineTestQuestionList" class="space-y-4">
                            <!-- Dynamically populated -->
                        </div>

                        <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <span class="text-xs text-slate-500 font-medium">✨ All 10 questions loaded. Customize your answers before submitting!</span>
                            <div class="flex items-center gap-3">
                                <button type="button" onclick="closeInlineTestSection()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                                    Cancel
                                </button>
                                <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-lg transition flex items-center gap-2 cursor-pointer">
                                    <i data-lucide="send" class="w-4 h-4"></i>
                                    <span>Submit Assessment & Evaluate Round</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- View 3: Interview -->
        <div id="view-interview" class="space-y-4 hidden">
            <!-- Dynamic Resume Context Banner -->
            <!-- Dynamic Resume & Domain Context Banner -->
            <div id="interviewContextBanner" class="bg-gradient-to-r from-indigo-900 via-indigo-950 to-slate-900 text-white px-5 py-3.5 rounded-2xl flex flex-wrap items-center justify-between text-xs shadow-md border border-indigo-800/60 gap-3">
                <div class="flex items-center gap-3 flex-wrap">
                    <span class="bg-emerald-500 text-slate-950 font-bold px-2.5 py-1 rounded-full text-[10px] uppercase tracking-wider shadow-sm flex items-center gap-1">
                        <i data-lucide="layers" class="w-3 h-3"></i> PRACTICE TRACK
                    </span>
                    <div class="flex items-center gap-1.5">
                        <label for="interviewDomainSelect" class="text-xs text-indigo-200 font-semibold">Target Domain:</label>
                        <select id="interviewDomainSelect" onchange="changeInterviewDomain()" class="bg-slate-800 text-white text-xs font-semibold px-3 py-1.5 rounded-xl border border-indigo-500/50 outline-none focus:ring-2 focus:ring-emerald-400 cursor-pointer">
                            <option value="resume">📄 My Extracted Resume Profile</option>
                            <option value="python">🐍 Python & FastAPI Backend</option>
                            <option value="fullstack">⚛️ Full Stack Web (React + FastAPI)</option>
                            <option value="java">☕ Java & Spring Boot Enterprise</option>
                            <option value="dsa">⚡ Data Structures & Algorithms</option>
                            <option value="sql">🗄️ SQL & Relational Databases</option>
                            <option value="cloud">☁️ Cloud & DevOps (Docker / K8s / CI/CD)</option>
                            <option value="hr">🤝 HR, Behavioral & Leadership</option>
                        </select>
                    </div>
                    <span id="activeSkillsList" class="text-indigo-200 text-[11px] font-medium hidden sm:inline">Active Skills: Python, FastAPI, React, SQL, Docker</span>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="openAdaptiveInterviewModal()" id="btnStartAdaptiveModal" class="px-3.5 py-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="bot" class="w-3.5 h-3.5 text-emerald-200"></i>
                        <span>🤖 Adaptive Multi-Turn Interview</span>
                    </button>
                    <button onclick="openProjectDefenseModal()" id="btnStartDefenseModal" class="px-3.5 py-1.5 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="shield" class="w-3.5 h-3.5 text-purple-200"></i>
                        <span>🛡️ Project Defense Viva Simulator</span>
                    </button>
                    <button onclick="fetchRandomizedQuestions()" id="btnRegenerateQ" class="px-3 py-1.5 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl border border-white/20 transition flex items-center gap-1.5 cursor-pointer">
                        <i data-lucide="shuffle" class="w-3.5 h-3.5 text-amber-300"></i>
                        <span>Shuffle Qs</span>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-white rounded-2xl p-6 text-slate-900 space-y-4 shadow-md border border-slate-200">
                    <!-- Webcam Container -->
                    <div class="aspect-video bg-slate-950 rounded-2xl flex items-center justify-center relative overflow-hidden shadow-inner border border-slate-800">
                        <video id="webcamVideo" autoplay playsinline muted class="w-full h-full object-cover"></video>
                        <canvas id="simulatedCamCanvas" class="w-full h-full object-cover absolute inset-0 pointer-events-none z-10"></canvas>
                        <div id="camPrompt" class="text-center p-4 z-10">
                            <i data-lucide="video" class="w-10 h-10 text-slate-500 mx-auto mb-2"></i>
                            <span class="text-xs text-slate-300 block font-medium">Click 'Start Camera & Mic' to enable video & audio interview mode</span>
                            <span id="camErrorNote" class="text-[11px] text-amber-400 block mt-1 hidden"></span>
                        </div>
                        
                        <!-- Status Overlays -->
                        <div class="absolute top-3 left-3 flex gap-2 z-20">
                            <span id="camBadge" class="text-[10px] bg-slate-900/90 text-slate-300 px-2.5 py-1 rounded-lg font-mono border border-slate-700 flex items-center gap-1.5 shadow-sm">
                                <span class="w-2 h-2 rounded-full bg-slate-500"></span>Camera: Off
                            </span>
                            <span id="micBadge" class="text-[10px] bg-slate-900/90 text-slate-300 px-2.5 py-1 rounded-lg font-mono border border-slate-700 flex items-center gap-1.5 shadow-sm">
                                <span class="w-2 h-2 rounded-full bg-slate-500"></span>Mic: Off
                            </span>
                            <span id="recTimerBadge" class="text-[10px] bg-rose-950/90 text-rose-300 px-2.5 py-1 rounded-lg font-mono border border-rose-800 hidden flex items-center gap-1.5 shadow-sm">
                                <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span><span id="recTimerText">00:00</span>
                            </span>
                        </div>

                        <!-- Live Mic Audio Level VU Bar Overlay -->
                        <div id="audioMeterContainer" class="absolute bottom-3 left-3 right-3 bg-slate-950/90 backdrop-blur-sm px-3.5 py-2 rounded-xl border border-slate-800 flex items-center gap-3 hidden z-20">
                            <span class="text-[10px] text-slate-300 font-mono flex items-center gap-1.5 shrink-0">
                                <i data-lucide="mic" class="w-3.5 h-3.5 text-emerald-400"></i> Live Voice Level:
                            </span>
                            <div class="flex-1 bg-slate-800 h-2.5 rounded-full overflow-hidden">
                                <div id="audioLevelBar" class="bg-gradient-to-r from-emerald-500 via-amber-400 to-rose-500 h-full w-0 transition-all duration-75"></div>
                            </div>
                            <span id="audioLevelPct" class="text-[10px] text-slate-300 font-mono shrink-0">0%</span>
                        </div>
                    </div>

                    <!-- Dynamic Question Display with Navigation -->
                    <div class="p-5 bg-indigo-50/70 rounded-2xl border border-indigo-100 space-y-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span id="qIndexBadge" class="text-xs font-bold text-indigo-700 uppercase tracking-wide">Question 1 of 4</span>
                                <span id="qTopicBadge" class="text-[10px] bg-indigo-600 text-white px-2.5 py-0.5 rounded-full font-mono font-bold shadow-sm">Python</span>
                                <span id="qDiffBadge" class="text-[10px] bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-mono font-bold border border-emerald-200">MEDIUM</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <button onclick="fetchRandomizedQuestions()" id="btnRegenerateQ2" class="px-2.5 py-1 bg-white hover:bg-indigo-50 text-indigo-700 border border-indigo-200 text-xs font-bold rounded-lg transition flex items-center gap-1 shadow-sm">
                                    <i data-lucide="shuffle" class="w-3.5 h-3.5 text-indigo-600"></i> Shuffle
                                </button>
                                <button onclick="prevQuestion()" id="btnPrevQ" class="px-2.5 py-1 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-bold rounded-lg disabled:opacity-40 transition flex items-center gap-1" disabled>
                                    <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i> Prev
                                </button>
                                <button onclick="nextQuestion()" id="btnNextQ" class="px-2.5 py-1 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-bold rounded-lg disabled:opacity-40 transition flex items-center gap-1">
                                    Next <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        </div>
                        <p id="currentQuestionText" class="text-base text-slate-900 font-bold leading-relaxed">
                            Can you explain how Python manages memory, specifically focusing on reference counting and garbage collection?
                        </p>
                        <div id="targetConceptsContainer" class="flex flex-wrap items-center gap-1.5 pt-1">
                            <span class="text-[10px] text-slate-500 font-semibold mr-1">Target Concepts:</span>
                            <span class="text-[10px] bg-white text-indigo-800 border border-indigo-200 px-2 py-0.5 rounded font-semibold">reference counting</span>
                            <span class="text-[10px] bg-white text-indigo-800 border border-indigo-200 px-2 py-0.5 rounded font-semibold">garbage collection</span>
                            <span class="text-[10px] bg-white text-indigo-800 border border-indigo-200 px-2 py-0.5 rounded font-semibold">cyclic references</span>
                        </div>
                    </div>

                    <!-- Verbal Response Area -->
                    <div class="space-y-1.5">
                        <div class="flex justify-between items-center">
                            <label class="text-xs text-slate-800 font-bold flex items-center gap-1.5">
                                <i data-lucide="mic" class="w-3.5 h-3.5 text-indigo-600"></i>
                                Candidate Verbal Response (Live Speech / Editable):
                            </label>
                            <div class="flex items-center gap-2">
                                <span id="wordCountBadge" class="text-[11px] text-slate-500 font-mono font-semibold">0 words</span>
                                <span id="micStatusText" class="text-[11px] font-mono"></span>
                            </div>
                        </div>
                        <textarea id="liveAnswerInput" rows="4" class="w-full text-xs p-3.5 bg-slate-50 text-slate-900 border border-slate-300 rounded-xl font-mono focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none leading-relaxed shadow-sm placeholder:text-slate-400 font-sans text-sm" placeholder="Type your answer here or click 'Record Voice / STT' to speak naturally..." oninput="updateWordCount()"></textarea>
                    </div>

                    <!-- Multi-Modal Controls -->
                    <div class="flex flex-wrap gap-2 pt-1 items-center">
                        <button onclick="startCamAndMic()" id="btnStartMedia" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow">
                            <i data-lucide="video" class="w-4 h-4"></i>
                            <span id="startBtnText">Start Camera & Mic</span>
                        </button>

                        <button onclick="toggleMicrophone()" id="btnToggleMic" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow">
                            <i data-lucide="mic" class="w-4 h-4"></i>
                            <span id="micBtnText">Record Voice / STT</span>
                        </button>

                        <button onclick="toggleMicMute()" id="btnToggleMute" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl border border-slate-200 transition flex items-center gap-1.5">
                            <i data-lucide="mic-off" class="w-4 h-4 text-amber-600"></i>
                            <span id="muteBtnText">Mute Mic</span>
                        </button>

                        <button onclick="diagnoseHardwareMedia()" id="btnDiagnoseMedia" title="Diagnose hardware camera & mic access" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl border border-slate-200 transition flex items-center gap-1.5">
                            <i data-lucide="activity" class="w-4 h-4 text-cyan-600"></i>
                            <span>Check Devices</span>
                        </button>

                        <button onclick="toggleConceptsHint()" id="btnToggleHint" title="Toggle target concepts hint" class="px-3 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-800 text-xs font-bold rounded-xl border border-indigo-200 transition flex items-center gap-1.5">
                            <i data-lucide="lightbulb" class="w-4 h-4 text-amber-500"></i>
                            <span id="hintBtnText">Key Concepts Hint</span>
                        </button>
                        
                        <button onclick="evalAnswer()" id="btnEvalAnswer" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-md ml-auto cursor-pointer">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                            <span>Evaluate Answer</span>
                        </button>
                    </div>

                    <!-- Evaluator / Proctoring Simulation Controls (Hidden for students) -->
                    <div id="evaluatorSimPanel" class="p-3 bg-purple-50/60 rounded-xl border border-purple-200 hidden space-y-2">
                        <span class="text-[11px] font-bold text-purple-900 block flex items-center gap-1">
                            <i data-lucide="shield-alert" class="w-3.5 h-3.5 text-purple-600"></i>
                            Evaluator Sandbox: Proctoring Stress & Security Simulation Controls
                        </span>
                        <div class="flex flex-wrap gap-2">
                            <button onclick="toggleMultiPersonSim()" id="btnMultiPersonSim" class="px-3 py-1.5 bg-white hover:bg-purple-100 text-purple-800 text-xs font-bold rounded-lg border border-purple-300 transition flex items-center gap-1.5">
                                <i data-lucide="users" class="w-3.5 h-3.5 text-purple-600"></i>
                                <span id="multiPersonBtnText">Multi-Person Test</span>
                            </button>
                            <button onclick="toggleHeadPoseSim()" id="btnHeadPoseSim" class="px-3 py-1.5 bg-white hover:bg-amber-100 text-amber-900 text-xs font-bold rounded-lg border border-amber-300 transition flex items-center gap-1.5">
                                <i data-lucide="compass" class="w-3.5 h-3.5 text-amber-600"></i>
                                <span id="poseBtnText">Cycle Head Pose</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right Analytics Panel -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 space-y-4 shadow-sm">
                    <h3 class="font-bold text-sm text-slate-800 flex items-center gap-2">
                        <i data-lucide="activity" class="w-4 h-4 text-indigo-600"></i>
                        Observable Acoustic & Visual Signals
                    </h3>
                    <div class="space-y-3 text-xs">
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">Person Count (YOLO)</span>
                            <span id="signalPersonCount" class="font-bold text-emerald-600">1 Person (Candidate)</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">3D Head Pose (MediaPipe)</span>
                            <span id="signalHeadPose" class="font-bold text-indigo-600">Yaw: 0.0° | Pitch: 0.0°</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">Gaze Pose Orientation</span>
                            <span id="signalPoseState" class="font-bold text-emerald-600">LOOKING_CENTER</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">Speech Rate</span>
                            <span id="signalWpm" class="font-bold text-indigo-600">134.0 WPM (Optimal)</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">Filler Frequency</span>
                            <span id="signalFillers" class="font-bold text-emerald-600">2 ('um', 'basically')</span>
                        </div>
                        <div class="flex justify-between border-b border-slate-100 pb-2">
                            <span class="text-slate-500">Face In-Frame Ratio</span>
                            <span id="signalFaceRatio" class="font-bold text-indigo-600">98.5% (Engaged)</span>
                        </div>
                    </div>
                    <div class="p-3.5 bg-indigo-50/80 rounded-lg border border-indigo-100 space-y-1">
                        <span id="signalNlpScore" class="text-xs font-bold text-indigo-950 block">NLP Score: 85.0 / 100</span>
                        <div id="signalCoverageDetails" class="text-[11px] text-slate-600 leading-relaxed">
                            <span class="text-emerald-700 font-semibold">✓ Covered:</span> reference counting, garbage collection<br>
                            <span class="text-slate-500">• Missing:</span> cyclic references
                        </div>
                    </div>
                    <div id="evalFeedbackBox" class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-xs text-slate-700 hidden">
                    </div>
                </div>
            </div>
        </div>

        <!-- View 4: Placement -->
        <div id="view-placement" class="space-y-6 hidden">
            <!-- Header Banner -->
            <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span class="bg-emerald-600 text-emerald-100 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">Placement Directorate 2026</span>
                        <span id="activeDrivesBadge" class="text-indigo-300 text-xs font-mono font-bold">30 Active Campus Drives Open</span>
                    </div>
                    <h2 class="text-xl font-bold text-white">Campus Placement Drives & Eligibility Engine</h2>
                    <p class="text-xs text-slate-300 mt-1 max-w-2xl">Browse tier-1 product-based & service-based company openings, verify automated CGPA/Attendance cutoffs, and apply with your AI assessment profile.</p>
                </div>
                <button onclick="loadPlacementJobsLive()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-2 shadow">
                    <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                    <span>Refresh Job Drives</span>
                </button>
            </div>

            <!-- Official Candidate Placement Dossier Banner -->
            <div class="bg-gradient-to-r from-emerald-950 via-indigo-950 to-slate-900 text-white p-5 rounded-2xl border border-emerald-600/40 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3.5">
                    <div class="p-3 bg-emerald-600/30 rounded-xl border border-emerald-400/40 text-emerald-300">
                        <i data-lucide="file-check-2" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-sm text-white">Official Placement Dossier & Verification Report</h4>
                        <p class="text-xs text-slate-300 mt-0.5">Includes CGPA verification, batch attendance, 3-round selection scores, AI interview analytics, and company shortlisting status.</p>
                    </div>
                </div>
                <button onclick="downloadMyReport()" class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs rounded-xl transition shadow flex items-center gap-2 shrink-0 cursor-pointer">
                    <i data-lucide="download" class="w-4 h-4"></i>
