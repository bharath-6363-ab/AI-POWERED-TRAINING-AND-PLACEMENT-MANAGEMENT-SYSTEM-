                                <td class="p-3 font-mono text-rose-700 font-bold">MULTI_PERSON_INTRUSION</td>
                                <td class="p-3"><span class="px-2 py-0.5 bg-rose-600 text-white rounded font-mono text-[10px] font-bold">CRITICAL</span></td>
