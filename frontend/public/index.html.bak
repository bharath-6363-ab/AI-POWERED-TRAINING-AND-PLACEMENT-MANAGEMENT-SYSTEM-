                                <td class="p-3"><span class="px-2 py-0.5 bg-amber-500 text-white rounded font-mono text-[10px] font-bold">WARNING</span></td>
                                <td class="p-3 text-slate-700">MediaPipe 3D Yaw turned -32.5° (LOOKING_LEFT deflection)</td>
                                <td class="p-3 font-mono text-slate-500">2026-09-20 12:08:44</td>
                                <td class="p-3"><button onclick="alert('Audit Action: Head pose warning logged. Threshold within allowable tolerance.')" class="px-2.5 py-1 bg-slate-700 hover:bg-slate-800 text-white rounded font-bold text-[11px]">Dismiss</button></td>
                            </tr>
                            <tr class="hover:bg-slate-50 bg-rose-50/40">
                                <td class="p-3 font-bold text-slate-900">Vikram Verma (2024-EC-015)</td>
                                <td class="p-3 font-mono text-rose-700 font-bold">PHONE_DETECTED</td>
                                <td class="p-3"><span class="px-2 py-0.5 bg-rose-600 text-white rounded font-mono text-[10px] font-bold">HIGH</span></td>
                                <td class="p-3 text-slate-700">YOLOv8 identified cell phone device in candidate left hand</td>
                                <td class="p-3 font-mono text-slate-500">2026-09-20 11:52:10</td>
                                <td class="p-3"><button onclick="alert('Audit Action: Candidate flagged for mobile device violation.')" class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded font-bold text-[11px]">Flag Candidate</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Student Master Roster & Dossier Table -->
            <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-sm text-slate-900 flex items-center gap-2">
                            <i data-lucide="users" class="w-5 h-5 text-indigo-600"></i>
                            Student Candidate Performance & Proctoring Roster
                        </h3>
                        <p class="text-xs text-slate-500">View real-time candidate scores, attendance, eligibility status, and download complete PDF Dossiers.</p>
                    </div>
                    <input type="text" id="adminStudentSearch" onkeyup="filterAdminStudents()" placeholder="Search candidates..." class="text-xs px-3 py-1.5 border rounded-lg w-48 outline-none focus:ring-1 focus:ring-indigo-500">
                </div>
