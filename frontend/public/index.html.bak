        // Sequential 3-Round Pipeline Manager
        let currentRoundTestId = null;

        async function resetSequentialPipeline() {
            try {
                const resp = await fetch('/api/v1/placement/rounds/reset', { method: 'POST' });
                const data = await resp.json();
                alert(`RECRUITMENT PIPELINE RESET:\n\n${data.message || 'Scores reset successfully.'}\nRound 1 Aptitude Test is now active and ready!`);
                await loadSequentialPipelineWorkflow();
            } catch(err) {
                alert("Reset error: " + err.message);
            }
        }

        async function loadSequentialPipelineWorkflow() {
            try {
                const resp = await fetch('/api/v1/placement/rounds/workflow');
                const data = await resp.json();

                if (data && data.rounds) {
                    const r1 = data.rounds[0];
                    const r2 = data.rounds[1];
                    const r3 = data.rounds[2];

                    // Round 1 Aptitude
                    const r1ScoreEl = document.getElementById('scoreRound1Text');
                    const r1TagEl = document.getElementById('round1StatusTag');
                    const r1Btn = document.getElementById('btnStartRound1');
                    const card1 = document.getElementById('cardRound1');

                    if (r1.status === 'cleared') {
                        if (r1ScoreEl) r1ScoreEl.innerHTML = `<span class="text-emerald-600 font-bold">${r1.score}% (PASSED)</span>`;
                        if (r1TagEl) r1TagEl.innerHTML = `<span class="text-emerald-600 font-bold flex items-center gap-1"><i data-lucide="check-circle-2" class="w-4 h-4"></i> ✓ Cleared</span>`;
                        if (r1Btn) {
                            r1Btn.disabled = false;
                            r1Btn.className = "w-full py-3 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 border border-emerald-300 cursor-pointer shadow-sm";
                            r1Btn.innerHTML = `<i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i><span>Round 1 Cleared (${r1.score}%) — Re-take Test</span>`;
                            r1Btn.onclick = () => openRoundTestModal(r1.test_id || 1, 'Round 1: General Aptitude & Logical Reasoning (10 Questions)');
                        }
                    } else {
                        if (r1ScoreEl) r1ScoreEl.innerText = r1.score ? `${r1.score}%` : '--';
                        if (r1TagEl) r1TagEl.innerHTML = `<span class="text-emerald-600 font-bold flex items-center gap-1"><i data-lucide="play-circle" class="w-4 h-4"></i> Ready to Start</span>`;
                        if (r1Btn) {
                            r1Btn.disabled = false;
                            r1Btn.className = "w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2 cursor-pointer";
                            r1Btn.innerHTML = `<i data-lucide="check-square" class="w-4 h-4"></i><span>Start Round 1: Aptitude Test (10 Qs)</span>`;
                            r1Btn.onclick = () => openRoundTestModal(r1.test_id || 1, 'Round 1: General Aptitude & Logical Reasoning (10 Questions)');
                        }
                    }

                    // Round 2 Technical
                    const r2ScoreEl = document.getElementById('scoreRound2Text');
                    const r2TagEl = document.getElementById('round2StatusTag');
                    const r2Btn = document.getElementById('btnStartRound2');
                    const card2 = document.getElementById('cardRound2');

                    if (r2.is_unlocked) {
                        if (card2) card2.className = "bg-white p-6 rounded-2xl border-2 border-indigo-500 shadow-md flex flex-col justify-between space-y-4 opacity-100";
                        if (r2.status === 'cleared') {
                            if (r2ScoreEl) r2ScoreEl.innerHTML = `<span class="text-emerald-600 font-bold">${r2.score}% (PASSED)</span>`;
                            if (r2TagEl) r2TagEl.innerHTML = `<span class="text-emerald-600 font-bold flex items-center gap-1"><i data-lucide="check-circle-2" class="w-4 h-4"></i> ✓ Cleared</span>`;
                            if (r2Btn) {
                                r2Btn.disabled = false;
                                r2Btn.className = "w-full py-3 bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-bold text-xs rounded-xl transition flex items-center justify-center gap-2 border border-emerald-300 cursor-pointer shadow-sm";
                                r2Btn.innerHTML = `<i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i><span>Round 2 Cleared (${r2.score}%) — Re-take Test</span>`;
                                r2Btn.onclick = () => openRoundTestModal(r2.test_id || 2, 'Round 2: Technical & Coding Knowledge Assessment (10 Questions - Resume Tailored)');
                            }
                        } else {
                            if (r2ScoreEl) r2ScoreEl.innerText = r2.score ? `${r2.score}%` : '--';
                            if (r2TagEl) r2TagEl.innerHTML = `<span class="text-indigo-600 font-bold flex items-center gap-1"><i data-lucide="unlock" class="w-4 h-4"></i> Unlocked & Active</span>`;
                            if (r2Btn) {
                                r2Btn.disabled = false;
                                r2Btn.className = "w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2 cursor-pointer";
                                r2Btn.innerHTML = `<i data-lucide="code" class="w-4 h-4"></i><span>Start Round 2: Technical Test (10 Qs)</span>`;
                                r2Btn.onclick = () => openRoundTestModal(r2.test_id || 2, 'Round 2: Technical & Coding Knowledge Assessment (10 Questions - Resume Tailored)');
                            }
                        }
                    } else {
                        if (card2) card2.className = "bg-white p-6 rounded-2xl border border-slate-200 opacity-70 shadow-sm flex flex-col justify-between space-y-4";
                        if (r2TagEl) r2TagEl.innerHTML = `<span class="text-slate-500 font-bold flex items-center gap-1"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Locked (Clear R1)</span>`;
                        if (r2Btn) {
                            r2Btn.disabled = true;
                            r2Btn.className = "w-full py-3 bg-slate-200 text-slate-500 font-bold text-xs rounded-xl flex items-center justify-center gap-2 cursor-not-allowed";
                            r2Btn.innerHTML = `<i data-lucide="lock" class="w-4 h-4"></i><span>Round 2 Locked (Clear R1 First)</span>`;
                        }
                    }

                    // Round 3 AI Interview
                    const r3ScoreEl = document.getElementById('scoreRound3Text');
                    const r3TagEl = document.getElementById('round3StatusTag');
                    const r3Btn = document.getElementById('btnStartRound3');
                    const card3 = document.getElementById('cardRound3');

                    if (r3.is_unlocked) {
                        if (card3) card3.className = "bg-white p-6 rounded-2xl border-2 border-purple-500 shadow-md flex flex-col justify-between space-y-4 opacity-100";
                        if (r3.status === 'cleared') {
                            if (r3ScoreEl) r3ScoreEl.innerHTML = `<span class="text-emerald-600 font-bold">${r3.score}/100 (PASSED)</span>`;
                            if (r3TagEl) r3TagEl.innerHTML = `<span class="text-emerald-600 font-bold flex items-center gap-1"><i data-lucide="check-circle-2" class="w-4 h-4"></i> ✓ Cleared</span>`;
                            if (r3Btn) {
                                r3Btn.disabled = false;
                                r3Btn.className = "w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2";
                                r3Btn.innerHTML = `<i data-lucide="award" class="w-4 h-4"></i><span>Selection Completed (${r3.score}/100)</span>`;
                                r3Btn.onclick = () => showTab('interview');
                            }
                        } else {
                            if (r3ScoreEl) r3ScoreEl.innerText = r3.score ? `${r3.score}/100` : '--';
                            if (r3TagEl) r3TagEl.innerHTML = `<span class="text-purple-600 font-bold flex items-center gap-1"><i data-lucide="video" class="w-4 h-4"></i> Unlocked & Active</span>`;
                            if (r3Btn) {
                                r3Btn.disabled = false;
                                r3Btn.className = "w-full py-3 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center justify-center gap-2";
                                r3Btn.innerHTML = `<i data-lucide="video" class="w-4 h-4"></i><span>Launch Round 3: AI Interview</span>`;
                                r3Btn.onclick = () => showTab('interview');
                            }
                        }
                    } else {
                        if (card3) card3.className = "bg-white p-6 rounded-2xl border border-slate-200 opacity-70 shadow-sm flex flex-col justify-between space-y-4";
                        if (r3TagEl) r3TagEl.innerHTML = `<span class="text-slate-500 font-bold flex items-center gap-1"><i data-lucide="lock" class="w-3.5 h-3.5"></i> Locked (Clear R2)</span>`;
                        if (r3Btn) {
                            r3Btn.disabled = true;
                            r3Btn.className = "w-full py-3 bg-slate-200 text-slate-500 font-bold text-xs rounded-xl flex items-center justify-center gap-2 cursor-not-allowed";
                            r3Btn.innerHTML = `<i data-lucide="lock" class="w-4 h-4"></i><span>Round 3 Locked (Clear R2 First)</span>`;
                        }
                    }

                    // Stepper Badges
                    const s1 = document.getElementById('step1Indicator');
                    const s2 = document.getElementById('step2Indicator');
                    const s3 = document.getElementById('step3Indicator');

                    if (s1) s1.className = r1.status === 'cleared' ? "w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold font-mono" : "w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold font-mono";
                    if (s2) s2.className = r2.status === 'cleared' ? "w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold font-mono" : (r2.is_unlocked ? "w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-bold font-mono animate-pulse" : "w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold font-mono");
                    if (s3) s3.className = r3.status === 'cleared' ? "w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold font-mono" : (r3.is_unlocked ? "w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center font-bold font-mono animate-pulse" : "w-8 h-8 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center font-bold font-mono");
                }
                if (window.lucide) lucide.createIcons();
            } catch(e) {
                console.warn("Workflow fetch error:", e);
            }
        }

        async function openRoundTestModal(testId, testTitle) {
            currentRoundTestId = testId;
            const modal = document.getElementById('roundTestModal');
            const titleEl = document.getElementById('roundTestModalTitle');
            const container = document.getElementById('roundTestQuestionList');

            const inlineSec = document.getElementById('inlineTestSection');
            const inlineTitle = document.getElementById('inlineTestTitle');
            const inlineContainer = document.getElementById('inlineTestQuestionList');

            if (titleEl) titleEl.innerText = testTitle;
            if (inlineTitle) inlineTitle.innerText = testTitle;

            const loadingHtml = `<div class="p-8 text-center text-xs text-slate-500 flex items-center justify-center gap-2"><i data-lucide="loader" class="w-4 h-4 animate-spin text-indigo-600"></i> Loading 10 Assessment Questions...</div>`;
            if (container) container.innerHTML = loadingHtml;
            if (inlineContainer) inlineContainer.innerHTML = loadingHtml;

            if (modal) modal.classList.remove('hidden');
            if (inlineSec) {
                inlineSec.classList.remove('hidden');
                inlineSec.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            try {
                const resp = await fetch(`/api/v1/tests/${testId}/questions`);
                const questions = await resp.json();

                if (questions && questions.length > 0) {
                    const qHtml = questions.map((q, idx) => `
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3">
                            <div class="flex items-start justify-between gap-2">
                                <h4 class="font-bold text-xs text-slate-900 leading-snug">Q${idx + 1}. ${q.question_text}</h4>
                                <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 text-[10px] font-bold rounded font-mono border border-indigo-100 shrink-0">${q.marks} Marks</span>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700 font-medium pt-1">
                                <label class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                                    <input type="radio" name="q_${q.id}" value="A" checked class="text-indigo-600 focus:ring-indigo-500">
                                    <span><strong>A.</strong> ${q.option_a}</span>
                                </label>
                                <label class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                                    <input type="radio" name="q_${q.id}" value="B" class="text-indigo-600 focus:ring-indigo-500">
                                    <span><strong>B.</strong> ${q.option_b}</span>
                                </label>
                                <label class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                                    <input type="radio" name="q_${q.id}" value="C" class="text-indigo-600 focus:ring-indigo-500">
                                    <span><strong>C.</strong> ${q.option_c}</span>
                                </label>
                                <label class="flex items-center gap-2.5 p-2.5 bg-white rounded-lg border border-slate-200 hover:border-indigo-300 cursor-pointer transition">
                                    <input type="radio" name="q_${q.id}" value="D" class="text-indigo-600 focus:ring-indigo-500">
                                    <span><strong>D.</strong> ${q.option_d}</span>
                                </label>
                            </div>
                        </div>
                    `).join('');

                    if (container) container.innerHTML = qHtml;
                    if (inlineContainer) inlineContainer.innerHTML = qHtml;
                } else {
                    const noQHtml = `<div class="p-8 text-center text-xs text-slate-500">No questions found for this test.</div>`;
                    if (container) container.innerHTML = noQHtml;
                    if (inlineContainer) inlineContainer.innerHTML = noQHtml;
                }
            } catch(err) {
                const errHtml = `<div class="p-8 text-center text-xs text-rose-500">Failed to load test questions: ${err.message}</div>`;
                if (container) container.innerHTML = errHtml;
                if (inlineContainer) inlineContainer.innerHTML = errHtml;
            } finally {
                if (window.lucide) lucide.createIcons();
            }
        }

        function closeRoundTestModal() {
            const modal = document.getElementById('roundTestModal');
            if (modal) modal.classList.add('hidden');
        }

        function closeInlineTestSection() {
            const inlineSec = document.getElementById('inlineTestSection');
            if (inlineSec) inlineSec.classList.add('hidden');
        }

        async function submitInlineTestAssessment(e) {
            e.preventDefault();
            const form = document.getElementById('inlineTestForm');
            await handleTestSubmissionFromForm(form);
        }

        async function submitRoundTestAssessment(e) {
            e.preventDefault();
            const form = document.getElementById('roundTestForm');
            await handleTestSubmissionFromForm(form);
        }

        async function handleTestSubmissionFromForm(form) {
            if (!currentRoundTestId) return;

            const formData = new FormData(form);
            const answers = [];

            for (const [key, value] of formData.entries()) {
                if (key.startsWith('q_')) {
                    const qId = parseInt(key.replace('q_', ''));
                    answers.push({ question_id: qId, selected_option: value });
                }
            }

            try {
                const headers = { 'Content-Type': 'application/json' };
                if (currentUser && currentUser.access_token) {
                    headers['Authorization'] = `Bearer ${currentUser.access_token}`;
                }
                const resp = await fetch(`/api/v1/tests/${currentRoundTestId}/submit`, {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ answers })
                });

                const res = await resp.json();
                closeRoundTestModal();
                closeInlineTestSection();

                if (resp.ok) {
                    alert(`RECRUITMENT ASSESSMENT SUBMITTED:\n\nScore: ${res.score} / ${res.total_possible} (${res.percentage}%)\nStatus: ${res.passed ? '✓ PASSED & CLEARED!' : '⚠️ Below Cutoff Score'}\n\n${res.passed ? 'Congratulations! Unlocked next recruitment round!' : 'You may re-attempt the test to improve score.'}`);
                    await loadSequentialPipelineWorkflow();
                } else {
                    alert("Submission error: " + (res.detail || "Unable to submit test"));
                }
            } catch(err) {
                alert("Network error submitting test: " + err.message);
            }
        }

        let allPlacementJobs = [];
        let appliedJobIds = new Set();
        let activeCompanyCategoryFilter = 'ALL';

        function filterCompanyCategory(category) {
            activeCompanyCategoryFilter = category;
            
            const btnAll = document.getElementById('btnFilterAll');
            const btnProd = document.getElementById('btnFilterProduct');
            const btnServ = document.getElementById('btnFilterService');

            if (btnAll) btnAll.className = category === 'ALL' ? "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-indigo-600 text-white shadow-sm" : "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-slate-200";
            if (btnProd) btnProd.className = category === 'PRODUCT' ? "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-purple-600 text-white shadow-sm" : "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-purple-50 hover:text-purple-700";
            if (btnServ) btnServ.className = category === 'SERVICE' ? "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-blue-600 text-white shadow-sm" : "px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-slate-100 text-slate-700 hover:bg-blue-50 hover:text-blue-700";

            renderPlacementJobsContainer();
        }

        function filterJobsByText() {
            renderPlacementJobsContainer();
        }

        function renderPlacementJobsContainer() {
            const container = document.getElementById('placementJobContainer');
            if (!container) return;

            const searchInput = document.getElementById('jobSearchInput');
            const searchText = searchInput ? searchInput.value.trim().toLowerCase() : '';

            let filtered = allPlacementJobs.filter(j => {
                const ind = (j.company_industry || '').toLowerCase();
                if (activeCompanyCategoryFilter === 'PRODUCT' && !ind.includes('product')) return false;
                if (activeCompanyCategoryFilter === 'SERVICE' && !ind.includes('service')) return false;

                if (searchText) {
                    const company = (j.company_name || '').toLowerCase();
                    const title = (j.title || '').toLowerCase();
                    const location = (j.location || '').toLowerCase();
                    return company.includes(searchText) || title.includes(searchText) || location.includes(searchText);
                }
                return true;
            });

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="col-span-full bg-white p-8 rounded-2xl border border-slate-200 text-center space-y-2">
                        <i data-lucide="building-2" class="w-10 h-10 text-slate-300 mx-auto"></i>
                        <h4 class="font-bold text-sm text-slate-700">No Job Drives Found</h4>
                        <p class="text-xs text-slate-400">Try changing your filter category or search keyword.</p>
                    </div>
                `;
                if (window.lucide) lucide.createIcons();
                return;
            }

            container.innerHTML = filtered.map(j => {
                const req = j.requirements || {};
                const minCgpa = req.min_cgpa || 6.0;
                const minAtt = req.min_attendance_pct || 75.0;
                const skills = (req.required_skills || []).map(s => `<span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded font-mono text-[10px] border border-indigo-100">${s}</span>`).join(' ');

                const userCgpa = (currentUser && currentUser.cgpa) ? currentUser.cgpa : 8.75;
                const userAtt = (currentUser && currentUser.attendance_pct) ? currentUser.attendance_pct : 88.5;
                const isEligible = (userCgpa >= minCgpa) && (userAtt >= minAtt);
                const hasApplied = appliedJobIds.has(j.id);

                const ind = j.company_industry || 'Product-Based';
                const isProduct = ind.toLowerCase().includes('product');
                const catBadgeClass = isProduct ? 'bg-purple-100 text-purple-800 border-purple-200' : 'bg-blue-100 text-blue-800 border-blue-200';
                const catIcon = isProduct ? '🚀' : '💼';

                let statusBadgeHtml = '';
                if (hasApplied) {
                    statusBadgeHtml = `
                        <span class="text-[11px] text-emerald-700 font-bold flex items-center gap-1 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                            <i data-lucide="check-circle-2" class="w-3.5 h-3.5 text-emerald-600"></i>
                            Shortlisted & Applied
                        </span>
                    `;
                } else {
                    statusBadgeHtml = `
                        <span class="text-[11px] ${isEligible ? 'text-emerald-700 font-bold' : 'text-amber-700 font-semibold'} flex items-center gap-1">
                            <i data-lucide="${isEligible ? 'check-circle-2' : 'alert-triangle'}" class="w-3.5 h-3.5"></i>
                            ${isEligible ? 'CGPA & Attendance Satisfied' : 'Requires Minimum Cutoff Check'}
                        </span>
                    `;
                }

                let buttonHtml = '';
                if (hasApplied) {
                    buttonHtml = `
                        <button onclick="downloadMyReport()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-1.5 cursor-pointer">
                            <i data-lucide="download" class="w-4 h-4"></i>
                            <span>Download PDF Report</span>
                        </button>
                    `;
                } else {
                    buttonHtml = `
                        <button onclick="applyJobDrive(${j.id}, '${j.company_name.replace(/'/g, "\\'")}', '${j.title.replace(/'/g, "\\'")}', ${minCgpa})" class="px-4 py-2 ${isEligible ? 'bg-indigo-600 hover:bg-indigo-700 text-white' : 'bg-slate-200 text-slate-700'} text-xs font-bold rounded-xl transition shadow-sm">
                            ${isEligible ? 'Apply Now (Eligible)' : 'Check Eligibility'}
                        </button>
                    `;
                }

                return `
                    <div class="bg-white p-5 rounded-2xl border ${hasApplied ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200'} shadow-sm flex flex-col justify-between space-y-4 hover:border-indigo-300 transition">
                        <div class="space-y-3">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide block">${j.company_name}</span>
                                        <span class="px-2 py-0.5 text-[10px] font-bold rounded-full border ${catBadgeClass}">${catIcon} ${ind}</span>
                                    </div>
                                    <h3 class="font-bold text-sm text-slate-900 leading-tight mt-0.5">${j.title}</h3>
                                </div>
                                <span class="px-3 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full font-bold font-mono text-xs shrink-0">${j.salary_lpa} LPA</span>
                            </div>

                            <p class="text-xs text-slate-600 leading-relaxed">${j.description || ''}</p>

                            <div class="space-y-1.5 pt-1">
                                <div class="flex items-center justify-between text-[11px] text-slate-500 font-medium">
                                    <span>Location: <strong class="text-slate-800">${j.location || 'India'}</strong></span>
                                    <span>Min Cutoff: <strong class="text-slate-800">CGPA ${minCgpa} | Att ${minAtt}%</strong></span>
                                </div>
                                <div class="flex flex-wrap gap-1 items-center pt-1">
                                    <span class="text-[10px] text-slate-400 mr-1">Required:</span>
                                    ${skills}
                                </div>
                            </div>
                        </div>

                        <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                            ${statusBadgeHtml}
                            ${buttonHtml}
                        </div>
                    </div>
                `;
            }).join('');
            if (window.lucide) lucide.createIcons();
        }

        async function loadPlacementJobsLive() {
            try {
                try {
                    const headers = {};
                    if (currentUser && currentUser.access_token) {
                        headers['Authorization'] = `Bearer ${currentUser.access_token}`;
                    }
                    const appResp = await fetch('/api/v1/placement/my-applications', { headers });
                    const myApps = await appResp.json();
                    if (Array.isArray(myApps)) {
                        appliedJobIds = new Set(myApps.map(a => a.job_id));
                    }
                } catch(ae) {
                    console.warn("My applications fetch error:", ae);
                }

                const resp = await fetch('/api/v1/placement/jobs');
                const jobs = await resp.json();

                if (jobs && jobs.length > 0) {
                    allPlacementJobs = jobs;

                    const prodCount = jobs.filter(j => (j.company_industry || '').toLowerCase().includes('product')).length;
                    const servCount = jobs.filter(j => (j.company_industry || '').toLowerCase().includes('service')).length;

                    const cntAllEl = document.getElementById('cntAll');
                    const cntProdEl = document.getElementById('cntProduct');
                    const cntServEl = document.getElementById('cntService');
                    const activeDrivesEl = document.getElementById('activeDrivesBadge');

                    if (cntAllEl) cntAllEl.innerText = jobs.length;
                    if (cntProdEl) cntProdEl.innerText = prodCount;
                    if (cntServEl) cntServEl.innerText = servCount;
                    if (activeDrivesEl) activeDrivesEl.innerText = `${jobs.length} Active Campus Drives Open (${prodCount} Product-Based + ${servCount} Service-Based)`;

                    renderPlacementJobsContainer();
                }
            } catch(e) {
                console.warn("Placement jobs fetch error:", e);
            }
        }

        function closeApplicationResultModal() {
            const modal = document.getElementById('applicationResultModal');
            if (modal) modal.classList.add('hidden');
        }

        async function applyJobDrive(jobId, company, title, minCgpa) {
            try {
                const headers = { 'Content-Type': 'application/json' };
                if (currentUser && currentUser.access_token) {
                    headers['Authorization'] = `Bearer ${currentUser.access_token}`;
                }
                const resp = await fetch(`/api/v1/placement/jobs/${jobId}/apply`, {
                    method: 'POST',
                    headers: headers
                });
                const res = await resp.json();
                if (resp.ok) {
                    appliedJobIds.add(jobId);
                    
                    const modal = document.getElementById('applicationResultModal');
                    const compEl = document.getElementById('appCompanyName');
                    const roleEl = document.getElementById('appJobRole');

                    if (compEl) compEl.innerText = company;
                    if (roleEl) roleEl.innerText = `${title} • Min CGPA Cutoff: ${minCgpa}`;

                    if (modal) {
                        modal.classList.remove('hidden');
                        if (window.lucide) lucide.createIcons();
                    } else {
                        alert(`🎉 CONGRATULATIONS! CANDIDATE SHORTLISTED!\n\nCompany: ${company}\nRole: ${title}\nApplication Status: SHORTLISTED FOR CAMPUS DRIVE!`);
                    }
                    renderPlacementJobsContainer();
                } else {
                    alert("Application Notice: " + (res.detail || "Unable to apply for drive"));
                }
            } catch(err) {
                alert("Application error: " + err.message);
            }
        }

        // =========================================================================
        // FEATURE 1: ATS Resume & Job Description Skill-Gap Analyzer
        // =========================================================================
        function onGapJobSelectChange() {
            const val = document.getElementById('gapJobSelect').value;
            const input = document.getElementById('gapJdInput');
            if (val === '1') {
                input.value = "Cognitive Cloud Tech - Python Cloud Backend Engineer (14.5 LPA)\nRequirements: Python, FastAPI, Docker, SQL, Kubernetes, CI/CD, and Redis caching. Strong knowledge of REST APIs and data structures required.";
            } else if (val === '2') {
                input.value = "Apex Quantum Systems - Full Stack Platform Engineer (12.0 LPA)\nRequirements: React, TypeScript, FastAPI, PostgreSQL, Docker, Microservices, and Agile methodologies.";
            } else if (val === '3') {
                input.value = "Deloitte USI - Systems Integration Analyst (8.5 LPA)\nRequirements: Java, Python, SQL, REST APIs, Git, Unit Testing, and Cloud fundamentals.";
            } else if (val === '4') {
                input.value = "TCS Digital - Digital Software Engineer (7.5 LPA)\nRequirements: Data Structures, Algorithms, Python, Java, SQL, OOP, and Web Technologies.";
            } else {
                input.value = "";
                input.focus();
            }
        }

        async function runAtsSkillGapAnalysis() {
            const btn = document.getElementById('btnRunSkillGap');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Analyzing ATS Gaps...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            const jobSelect = document.getElementById('gapJobSelect').value;
            const jdText = document.getElementById('gapJdInput').value.trim();
            const resumeText = document.getElementById('resumeTextInput').value.trim();

            const payload = {
                resume_text: resumeText,
                job_description: jdText,
                job_id: jobSelect !== 'custom' ? parseInt(jobSelect) : null
            };

            try {
                const resp = await fetch('/api/v1/resume/analyze-gap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (data.status === 'success' && data.analysis) {
                    const res = data.analysis;
                    const container = document.getElementById('gapResultContainer');
                    container.classList.remove('hidden');

                    document.getElementById('gapAtsScore').innerText = `${res.ats_score}%`;
                    document.getElementById('gapKeywordMatch').innerText = `${res.keyword_match_pct}%`;
                    document.getElementById('gapSemanticSim').innerText = `${res.semantic_similarity_pct}%`;
                    document.getElementById('gapVerdict').innerText = res.verdict;

                    // Matched Pills
                    document.getElementById('gapMatchedCount').innerText = res.matched_skills_count;
                    const matchedContainer = document.getElementById('gapMatchedPills');
                    matchedContainer.innerHTML = res.matched_skills.map(s => 
                        `<span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-full font-mono text-[11px] font-bold border border-emerald-200">✓ ${s}</span>`
                    ).join('') || `<span class="text-slate-400 italic">No direct keyword overlap</span>`;

                    // Missing Pills
                    document.getElementById('gapMissingCount').innerText = res.missing_skills_count;
                    const missingContainer = document.getElementById('gapMissingPills');
                    missingContainer.innerHTML = res.missing_skills.map(s => 
                        `<span class="px-2.5 py-1 bg-rose-100 text-rose-800 rounded-full font-mono text-[11px] font-bold border border-rose-200">⚠ ${s}</span>`
                    ).join('') || `<span class="text-emerald-600 font-bold">100% Core Requirements Covered!</span>`;

                    // Recommendations
                    const recContainer = document.getElementById('gapRecommendations');
                    recContainer.innerHTML = res.recommendations.map(r => 
                        `<p class="p-2.5 bg-white rounded-lg border border-slate-200 flex items-start gap-2 leading-relaxed">
                            <span class="text-indigo-600 font-bold shrink-0">▸</span>
                            <span>${r}</span>
                        </p>`
                    ).join('') || `<p class="p-2.5 bg-emerald-50 text-emerald-800 rounded-lg">Outstanding ATS match! Resume is optimized for direct submission.</p>`;

                    if (window.lucide) lucide.createIcons();
                    container.scrollIntoView({ behavior: 'smooth' });
                }
            } catch(e) {
                alert("Skill-gap analysis error: " + e.message);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

        // =========================================================================
        // FEATURE 2: Adaptive Multi-Turn AI Interviewer (State Machine)
        // =========================================================================
        let activeAdaptiveSessionId = null;

        function openAdaptiveInterviewModal() {
            const modal = document.getElementById('adaptiveInterviewModal');
            if (modal) modal.classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
            startNewAdaptiveSession();
        }

        function closeAdaptiveInterviewModal() {
            const modal = document.getElementById('adaptiveInterviewModal');
            if (modal) modal.classList.add('hidden');
        }

        function updateAdaptiveWordCount() {
            const val = document.getElementById('adaptiveAnswerInput').value.trim();
            const words = val ? val.split(/\s+/).length : 0;
            document.getElementById('adaptiveWordCount').innerText = `${words} words`;
        }

        async function startNewAdaptiveSession() {
            const skills = currentResumeSkills && currentResumeSkills.length > 0 ? currentResumeSkills : ["Python", "FastAPI", "SQL"];
            try {
                const resp = await fetch('/api/v1/interviews/session/start', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        job_role: "Software Engineer",
                        skills: skills,
                        question_count: 3
                    })
                });
                const data = await resp.json();
                if (data.status === 'success' && data.session) {
                    activeAdaptiveSessionId = data.session.session_id;
                    renderAdaptiveQuestionTurn(data.session);
                    document.getElementById('adaptiveHistoryList').innerHTML = '';
                    document.getElementById('adaptiveScorecardContainer').classList.add('hidden');
                    document.getElementById('adaptiveInputSection').classList.remove('hidden');
                    document.getElementById('adaptiveFollowUpAlert').classList.add('hidden');
                }
            } catch(e) {
                alert("Failed to start adaptive session: " + e.message);
            }
        }

        function renderAdaptiveQuestionTurn(sessionInfo) {
            const q = sessionInfo.question || sessionInfo.next_question;
            if (!q) return;

            const qNum = sessionInfo.current_question_number || 1;
            const total = sessionInfo.total_questions || 3;
            const isFollowUp = sessionInfo.is_follow_up || false;

            document.getElementById('adaptiveStateBadge').innerText = isFollowUp ? `ADAPTIVE PROBING TURN` : `QUESTION ${qNum} OF ${total}`;
            document.getElementById('adaptiveTurnBadge').innerText = isFollowUp ? `FOLLOW-UP PROBING (ADAPTIVE)` : `PRIMARY QUESTION ${qNum}`;
            document.getElementById('adaptiveTurnBadge').className = isFollowUp ? "px-2.5 py-0.5 bg-amber-500 text-slate-950 text-[10px] font-bold rounded-full uppercase font-mono shadow-sm" : "px-2.5 py-0.5 bg-teal-600 text-white text-[10px] font-bold rounded-full uppercase font-mono";
            document.getElementById('adaptiveTopicBadge').innerText = q.topic || "Core Technical";
            document.getElementById('adaptiveQuestionText').innerText = q.question_text || "";

            const concepts = q.expected_concepts || [];
            document.getElementById('adaptiveConceptsPills').innerHTML = concepts.map(c => 
                `<span class="px-2 py-0.5 bg-white text-teal-800 border border-teal-200 rounded text-[10px] font-semibold">${c}</span>`
            ).join('');

            const followUpAlert = document.getElementById('adaptiveFollowUpAlert');
            if (isFollowUp) {
                followUpAlert.classList.remove('hidden');
                document.getElementById('adaptiveFollowUpText').innerText = sessionInfo.follow_up_reason || "Interviewer is probing deeper into under-explained concepts.";
            } else {
                followUpAlert.classList.add('hidden');
            }

            document.getElementById('adaptiveAnswerInput').value = '';
            updateAdaptiveWordCount();
            if (window.lucide) lucide.createIcons();
        }

        async function submitAdaptiveTurnAnswer() {
            const answerText = document.getElementById('adaptiveAnswerInput').value.trim();
            if (!answerText) {
                alert("Please provide an answer before submitting.");
                return;
            }

            const btn = document.getElementById('btnSubmitAdaptiveTurn');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Evaluating & Synthesizing Next Turn...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            try {
                const words = answerText.split(/\s+/).length;
                const duration = Math.max(12.0, (words / 125.0) * 60.0);

                const resp = await fetch('/api/v1/interviews/session/turn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        session_id: activeAdaptiveSessionId,
                        answer_text: answerText,
                        duration_seconds: duration
                    })
                });

                const data = await resp.json();
                if (data.status === 'success' && data.data) {
                    const result = data.data;

                    // Append to history list
                    const evalData = result.turn_evaluation;
                    const historyList = document.getElementById('adaptiveHistoryList');
                    if (evalData) {
                        const nlp = evalData.nlp_evaluation;
                        const speech = evalData.speech_analysis;
                        const rubric = evalData.rubric || {};
                        const weakest = evalData.weakest_concept;
                        const itemHtml = `
                            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1.5">
                                <div class="flex justify-between items-center text-[11px]">
                                    <strong class="text-teal-900">Q: ${document.getElementById('adaptiveQuestionText').innerText}</strong>
                                    <span class="font-mono text-teal-700 font-bold bg-teal-50 px-2 py-0.5 rounded border border-teal-200">${nlp.technical_score}/100</span>
                                </div>
                                <p class="text-slate-600 text-[11px] italic">"${answerText}"</p>
                                <div class="grid grid-cols-4 gap-1 text-[10px] pt-1">
                                    <span class="p-1 bg-white rounded border border-slate-200 text-center">Correctness: <strong>${rubric.correctness_score ?? nlp.concept_coverage_pct}%</strong></span>
                                    <span class="p-1 bg-white rounded border border-slate-200 text-center">Depth: <strong>${rubric.depth_score ?? nlp.semantic_similarity}%</strong></span>
                                    <span class="p-1 bg-white rounded border border-slate-200 text-center">Relevance: <strong>${rubric.relevance_score ?? nlp.relevance_score}%</strong></span>
                                    <span class="p-1 bg-white rounded border border-slate-200 text-center">Fluency: <strong>${speech.words_per_minute} WPM</strong></span>
                                </div>
                                ${weakest ? `<div class="text-[10px] text-amber-700 bg-amber-50 px-2 py-1 rounded border border-amber-200">Targeted deficit probed: <strong>${weakest}</strong></div>` : ''}
                            </div>
                        `;
                        historyList.insertAdjacentHTML('afterbegin', itemHtml);
                    }

                    if (result.state === 'COMPLETED' || result.is_completed) {
                        // Render final scorecard
                        const summary = result.summary;
                        document.getElementById('adaptiveScorecardContainer').classList.remove('hidden');
                        document.getElementById('adaptiveInputSection').classList.add('hidden');
                        document.getElementById('adaptiveFollowUpAlert').classList.add('hidden');
                        document.getElementById('adaptiveFinalScore').innerText = `${summary.overall_score}/100`;
                        document.getElementById('adaptiveFinalTech').innerText = `${summary.average_technical_score}`;
                        document.getElementById('adaptiveFinalComm').innerText = `${summary.average_communication_score}`;
                        document.getElementById('adaptiveFinalWpm').innerText = `${summary.average_wpm} WPM`;
                        document.getElementById('adaptiveFinalVerdict').innerText = `${summary.verdict} - Comprehensive Scorecard Saved.`;
                        document.getElementById('adaptiveStateBadge').innerText = "SESSION COMPLETED";

                        // Strengths & Weak Areas
                        const strEl = document.getElementById('adaptiveStrengthsPills');
                        if (strEl) {
                            strEl.innerHTML = (summary.strengths || []).map(s => `<span class="px-2 py-0.5 bg-emerald-500/20 text-emerald-300 rounded font-mono text-[10px]">✓ ${s}</span>`).join('') || '<span class="text-slate-400 italic">None logged</span>';
                        }
                        const weakEl = document.getElementById('adaptiveWeakAreasPills');
                        if (weakEl) {
                            weakEl.innerHTML = (summary.weak_areas || []).map(w => `<span class="px-2 py-0.5 bg-rose-500/20 text-rose-300 rounded font-mono text-[10px]">⚠ ${w}</span>`).join('') || '<span class="text-emerald-400 font-bold">100% Concepts Mastered!</span>';
                        }
                        const recEl = document.getElementById('adaptiveRecommendationsList');
                        if (recEl) {
                            recEl.innerHTML = (summary.recommendations || []).map(r => `<p class="flex items-start gap-1"><span class="text-indigo-400 font-bold">▸</span> ${r}</p>`).join('');
                        }
                    } else {
                        // Render next question (or follow-up)
                        renderAdaptiveQuestionTurn(result);
                    }
                }
            } catch(e) {
                alert("Turn submission error: " + e.message);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

        // =========================================================================
        // FEATURE 3: Project-Defense Viva Simulator
        // =========================================================================
        let currentDefenseQuestions = [];

        function openProjectDefenseModal() {
            const modal = document.getElementById('projectDefenseModal');
            if (modal) modal.classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closeProjectDefenseModal() {
            const modal = document.getElementById('projectDefenseModal');
            if (modal) modal.classList.add('hidden');
        }

        async function generateDefenseQuestions() {
            const btn = document.getElementById('btnGenDefenseQs');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-4 h-4 animate-spin"></i><span>Generating Panel Questions...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            const title = document.getElementById('defenseTitleInput').value.trim();
            const stackStr = document.getElementById('defenseStackInput').value.trim();
            const desc = document.getElementById('defenseDescInput').value.trim();
            const stackArr = stackStr.split(',').map(s => s.trim()).filter(Boolean);

            try {
                const resp = await fetch('/api/v1/interviews/project-defense/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        project_title: title,
                        tech_stack: stackArr,
                        project_description: desc
                    })
                });
                const data = await resp.json();
                if (data.status === 'success' && data.questions) {
                    currentDefenseQuestions = data.questions;
                    renderDefenseQuestions();
                }
            } catch(e) {
                alert("Defense question generation failed: " + e.message);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }

        function renderDefenseQuestions() {
            const container = document.getElementById('defenseQuestionsContainer');
            container.innerHTML = currentDefenseQuestions.map((q, idx) => `
                <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="px-2.5 py-0.5 bg-purple-100 text-purple-800 text-[10px] font-bold rounded-full uppercase font-mono">
                            Dimension ${idx + 1}: ${q.category}
                        </span>
                        <span class="text-[11px] font-mono text-slate-500 font-semibold">Viva Defense</span>
                    </div>
                    <p class="text-sm font-bold text-slate-900 leading-relaxed">${q.question_text}</p>
                    <div class="flex flex-wrap gap-1.5 items-center">
                        <span class="text-[10px] text-slate-400 font-semibold">Key Architecture Concepts:</span>
                        ${(q.expected_concepts || []).map(c => `<span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded text-[10px] font-medium">${c}</span>`).join('')}
                    </div>

                    <!-- Candidate Answer Input Area -->
                    <div class="space-y-1.5 pt-1">
                        <textarea id="defenseAns_${idx}" rows="3" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg font-mono outline-none focus:ring-2 focus:ring-purple-500 leading-relaxed" placeholder="Present your architectural defense here..."></textarea>
                        <div class="flex justify-end">
                            <button onclick="submitDefenseAnswer(${idx})" id="btnDefend_${idx}" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-xs font-bold transition shadow flex items-center gap-1.5 cursor-pointer">
                                <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                                <span>Defend Answer to Panel</span>
                            </button>
                        </div>
                    </div>

                    <!-- Panel Critique Evaluation Container (Hidden until evaluated) -->
                    <div id="defenseFeedback_${idx}" class="hidden p-3.5 bg-slate-50 rounded-xl border border-slate-200 space-y-2 text-xs"></div>
                </div>
            `).join('');
            if (window.lucide) lucide.createIcons();
        }

        async function submitDefenseAnswer(idx) {
            const q = currentDefenseQuestions[idx];
            const answerInput = document.getElementById(`defenseAns_${idx}`);
            const answerText = answerInput ? answerInput.value.trim() : "";
            if (!answerText) {
                alert("Please write your defense answer before submitting.");
                return;
            }

            const btn = document.getElementById(`btnDefend_${idx}`);
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i data-lucide="loader" class="w-3.5 h-3.5 animate-spin"></i><span>Grading Defense...</span>`;
            btn.disabled = true;
            if (window.lucide) lucide.createIcons();

            try {
                const resp = await fetch('/api/v1/interviews/project-defense/evaluate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question_text: q.question_text,
                        expected_concepts: q.expected_concepts || [],
                        ideal_architect_answer: q.ideal_architect_answer || "",
                        student_answer: answerText,
                        project_title: document.getElementById('defenseTitleInput').value.trim()
                    })
                });
                const data = await resp.json();
                if (data.status === 'success' && data.data) {
                    const res = data.data;
                    const fbContainer = document.getElementById(`defenseFeedback_${idx}`);
                    fbContainer.classList.remove('hidden');

                    const verdictColor = res.score >= 70 ? 'text-emerald-700 bg-emerald-100' : (res.score >= 50 ? 'text-amber-800 bg-amber-100' : 'text-rose-800 bg-rose-100');
                    fbContainer.innerHTML = `
                        <div class="flex items-center justify-between">
                            <span class="px-2 py-0.5 rounded font-bold font-mono text-[10px] ${verdictColor}">${res.verdict}</span>
                            <span class="font-bold text-slate-800 text-sm">Defense Score: ${res.score}/100</span>
                        </div>
                        <p class="text-slate-700 leading-relaxed font-medium">${res.panel_feedback}</p>
                        <div class="p-2.5 bg-indigo-50 border border-indigo-200 rounded-lg space-y-1">
                            <span class="text-[10px] font-bold text-indigo-900 uppercase font-mono block">Senior Architect Model Answer:</span>
                            <p class="text-xs text-indigo-950 font-mono leading-relaxed">${res.model_architect_answer}</p>
                        </div>
                    `;
                    if (window.lucide) lucide.createIcons();
                }
            } catch(e) {
                alert("Defense evaluation error: " + e.message);
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                if (window.lucide) lucide.createIcons();
            }
        }
    </script>

    <!-- Login & Registration Modal -->
    <div id="loginModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200 space-y-0">
            <!-- Modal Header -->
            <div class="bg-indigo-950 text-white p-5 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="p-2 bg-indigo-600 rounded-lg">
                        <i data-lucide="lock" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base">AI-TPMS Portal Authentication</h3>
                        <p class="text-xs text-indigo-300">Sign in to your Student, Admin, or Trainer account</p>
                    </div>
                </div>
                <button onclick="closeLoginModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Tabs -->
            <div class="flex border-b border-slate-200 bg-slate-50 px-5 text-xs font-semibold">
                <button onclick="switchLoginTab('quick')" id="loginTab-quick" class="py-3 px-3 border-b-2 border-indigo-600 text-indigo-600 font-bold">Quick Demo Login</button>
                <button onclick="switchLoginTab('credentials')" id="loginTab-credentials" class="py-3 px-3 border-b-2 border-transparent text-slate-500">Sign In (Credentials)</button>
                <button onclick="switchLoginTab('register')" id="loginTab-register" class="py-3 px-3 border-b-2 border-transparent text-slate-500">Register Student</button>
            </div>

            <div class="p-6 space-y-4">
                <!-- Tab 1: Quick Demo Auto-Login -->
                <div id="loginContent-quick" class="space-y-3">
                    <p class="text-xs text-slate-500 mb-2">Select a pre-configured system role to automatically authenticate and switch perspectives:</p>

                    <button onclick="autoLoginRole('admin')" class="w-full p-3.5 bg-purple-50 hover:bg-purple-100/80 border border-purple-200 rounded-xl flex items-center justify-between text-left transition group">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-purple-600 text-white rounded-lg">
                                <i data-lucide="shield-check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <span class="font-bold text-xs text-purple-950 block">TPO Admin / System Director</span>
                                <span class="text-[11px] text-purple-700">admin@college.edu • Full Proctoring & Placement Control</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-purple-700 group-hover:translate-x-1 transition-transform">Sign In &rarr;</span>
                    </button>

                    <button onclick="autoLoginRole('student')" class="w-full p-3.5 bg-indigo-50 hover:bg-indigo-100/80 border border-indigo-200 rounded-xl flex items-center justify-between text-left transition group">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-indigo-600 text-white rounded-lg">
                                <i data-lucide="user-check" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <span class="font-bold text-xs text-indigo-950 block">Student Candidate (Aditi Rao)</span>
                                <span class="text-[11px] text-indigo-700">aditi.rao@student.edu • Roll: 2024-CS-042 | CGPA: 8.75</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-indigo-700 group-hover:translate-x-1 transition-transform">Sign In &rarr;</span>
                    </button>

                    <button onclick="autoLoginRole('trainer')" class="w-full p-3.5 bg-emerald-50 hover:bg-emerald-100/80 border border-emerald-200 rounded-xl flex items-center justify-between text-left transition group">
                        <div class="flex items-center gap-3">
                            <div class="p-2 bg-emerald-600 text-white rounded-lg">
                                <i data-lucide="award" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <span class="font-bold text-xs text-emerald-950 block">Industry Technical Trainer</span>
                                <span class="text-[11px] text-emerald-700">trainer@college.edu • Specialization: Cloud & AI</span>
                            </div>
                        </div>
                        <span class="text-xs font-bold text-emerald-700 group-hover:translate-x-1 transition-transform">Sign In &rarr;</span>
                    </button>
                </div>

                <!-- Tab 2: Custom Credentials Login -->
                <form id="loginContent-credentials" onsubmit="handleCredentialsLogin(event)" class="space-y-3 hidden">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">Email Address:</label>
                        <input type="email" id="loginEmail" required class="w-full text-xs p-3 bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="e.g. admin@college.edu">
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">Password:</label>
                        <input type="password" id="loginPassword" required class="w-full text-xs p-3 bg-slate-50 border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="••••••••">
                    </div>
                    <button type="submit" id="btnLoginSubmit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-2">
                        <i data-lucide="log-in" class="w-4 h-4"></i>
                        <span>Authenticate Account</span>
                    </button>
                </form>

                <!-- Tab 3: Register New Student -->
                <form id="loginContent-register" onsubmit="handleStudentRegistration(event)" class="space-y-2.5 hidden">
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Full Name:</label>
                            <input type="text" id="regFullName" required class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none" placeholder="Rohan Sharma">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Roll Number:</label>
                            <input type="text" id="regRollNo" required class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none" placeholder="2024-CS-099">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Email:</label>
                            <input type="email" id="regEmail" required class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none" placeholder="rohan@student.edu">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Password:</label>
                            <input type="password" id="regPassword" required class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none" placeholder="Student@123">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Branch:</label>
                            <input type="text" id="regBranch" value="CSE" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">Semester:</label>
                            <input type="number" id="regSemester" value="7" min="1" max="8" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-slate-700 block mb-0.5">CGPA:</label>
                            <input type="number" step="0.1" id="regCgpa" value="8.4" min="0" max="10" class="w-full text-xs p-2.5 bg-slate-50 border border-slate-300 rounded-lg outline-none">
                        </div>
                    </div>
                    <button type="submit" id="btnRegisterSubmit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold transition flex items-center justify-center gap-2 mt-2">
                        <i data-lucide="user-plus" class="w-4 h-4"></i>
                        <span>Register New Student Account</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Sequential Round Assessment Test Modal -->
    <div id="roundTestModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl border border-slate-200 flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div class="bg-indigo-950 text-white p-5 flex items-center justify-between shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="p-2 bg-indigo-600 rounded-lg">
                        <i data-lucide="file-check" class="w-5 h-5 text-white"></i>
                    </div>
                    <div>
                        <h3 id="roundTestModalTitle" class="font-bold text-base">Round 1: General Aptitude & Logical Reasoning</h3>
                        <p class="text-xs text-indigo-300">Read each question carefully and select the correct option.</p>
                    </div>
                </div>
                <button onclick="closeRoundTestModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Content (Scrollable Question List) -->
            <form id="roundTestForm" onsubmit="submitRoundTestAssessment(event)" class="p-6 overflow-y-auto space-y-4 flex-1">
                <div id="roundTestQuestionList" class="space-y-4">
                    <!-- Dynamically populated via openRoundTestModal() -->
                </div>
                <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                    <button type="button" onclick="closeRoundTestModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition shadow flex items-center gap-2">
                        <i data-lucide="send" class="w-4 h-4"></i>
                        <span>Submit Assessment</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- Post-Application Shortlisted & PDF Report Modal (Option 2) -->
    <div id="applicationResultModal" class="fixed inset-0 bg-slate-950/70 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full overflow-hidden shadow-2xl border border-slate-200 space-y-0">
            <!-- Modal Header Banner -->
            <div class="bg-gradient-to-r from-emerald-950 via-indigo-950 to-slate-900 text-white p-6 relative">
                <button onclick="closeApplicationResultModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
                <div class="flex items-center gap-3 mb-2">
                    <div class="p-2.5 bg-emerald-500 text-slate-950 rounded-xl font-bold shadow">
                        <i data-lucide="award" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <span class="bg-emerald-500/20 text-emerald-300 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-emerald-500/30">CAMPUS PLACEMENT DRIVE</span>
                        <h3 id="appResultTitle" class="font-bold text-lg text-white mt-0.5">🎉 CANDIDATE SHORTLISTED!</h3>
                    </div>
                </div>
                <p id="appResultSub" class="text-xs text-slate-300">Candidate meets all eligibility criteria and completed 3-round selection workflow.</p>
            </div>

            <!-- Modal Content Body -->
            <div class="p-6 space-y-5">
                <!-- Company & Job Role Card -->
                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-2">
                    <div class="flex items-center justify-between">
                        <span id="appCompanyCategory" class="px-2.5 py-0.5 bg-indigo-100 text-indigo-800 text-[10px] font-bold rounded font-mono">CAMPUS RECRUITMENT</span>
                        <span class="text-xs font-bold text-emerald-600 flex items-center gap-1">
                            <i data-lucide="check-circle-2" class="w-4 h-4"></i> Shortlisted
                        </span>
                    </div>
                    <h4 id="appCompanyName" class="font-bold text-base text-slate-900">Cognitive Cloud Tech</h4>
                    <p id="appJobRole" class="text-xs text-slate-600 font-medium">Senior Python Cloud Backend Engineer • ₹14.5 LPA</p>
                </div>

                <!-- Verified Criteria Summary Table -->
                <div class="space-y-2 text-xs">
                    <h5 class="font-bold text-slate-900 flex items-center gap-1.5">
                        <i data-lucide="file-check-2" class="w-4 h-4 text-emerald-600"></i>
                        <span>Verified Selection Evaluation Summary</span>
                    </h5>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 space-y-1.5">
                        <div class="flex justify-between text-slate-600"><span>Academic CGPA:</span> <strong class="text-emerald-700">8.75 (Req ≥ 7.5) ✓</strong></div>
                        <div class="flex justify-between text-slate-600"><span>Batch Attendance:</span> <strong class="text-emerald-700">88.5% (Req ≥ 75%) ✓</strong></div>
                        <div class="flex justify-between text-slate-600"><span>Round 1 Aptitude Test:</span> <strong class="text-emerald-700">100.0% (Passed) ✓</strong></div>
                        <div class="flex justify-between text-slate-600"><span>Round 2 Technical Test:</span> <strong class="text-emerald-700">100.0% (Passed) ✓</strong></div>
                        <div class="flex justify-between text-slate-600"><span>Round 3 Mock AI Interview:</span> <strong class="text-emerald-700">Verified & Proctor Cleared ✓</strong></div>
                    </div>
                </div>

                <!-- Action Button Section -->
                <div class="pt-2 border-t border-slate-100 space-y-2.5">
                    <button onclick="downloadMyReport()" class="w-full py-3.5 bg-gradient-to-r from-emerald-600 to-indigo-600 hover:from-emerald-700 hover:to-indigo-700 text-white rounded-xl text-xs font-bold transition shadow-lg flex items-center justify-center gap-2 cursor-pointer">
                        <i data-lucide="download" class="w-4.5 h-4.5"></i>
                        <span>Download Official PDF Evaluation Report</span>
                    </button>
                    <button onclick="closeApplicationResultModal()" class="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition">
                        Close & View Job Drives
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Adaptive Multi-Turn AI Interview Modal -->
    <div id="adaptiveInterviewModal" class="fixed inset-0 bg-slate-950/75 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl border border-slate-200 flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-gradient-to-r from-teal-950 via-slate-900 to-indigo-950 text-white p-5 flex items-center justify-between border-b border-teal-800/40">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-teal-500 text-slate-950 rounded-xl font-bold shadow">
                        <i data-lucide="bot" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="bg-teal-500/20 text-teal-300 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider font-mono border border-teal-500/30">STATE MACHINE ENGINE</span>
                            <span id="adaptiveStateBadge" class="bg-indigo-500/20 text-indigo-300 text-[10px] font-bold px-2 py-0.5 rounded-full font-mono">TURN 1 OF 3</span>
                        </div>
                        <h3 class="font-bold text-base text-white mt-0.5">Adaptive Multi-Turn Technical Interview</h3>
                    </div>
                </div>
                <button onclick="closeAdaptiveInterviewModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 overflow-y-auto space-y-5 flex-1">
                <!-- Turn Question Card -->
                <div id="adaptiveTurnCard" class="p-4 bg-teal-50/60 rounded-xl border border-teal-200 space-y-2">
                    <div class="flex items-center justify-between">
                        <span id="adaptiveTurnBadge" class="px-2.5 py-0.5 bg-teal-600 text-white text-[10px] font-bold rounded-full uppercase font-mono">PRIMARY QUESTION</span>
                        <span id="adaptiveTopicBadge" class="text-xs font-mono font-bold text-teal-800">Python</span>
                    </div>
                    <p id="adaptiveQuestionText" class="text-sm font-bold text-slate-900 leading-relaxed">
                        Initializing adaptive interview session...
                    </p>
                    <div id="adaptiveConceptsPills" class="flex flex-wrap gap-1.5 pt-1"></div>
                </div>

                <!-- Follow-up Notice (Shown during probing) -->
                <div id="adaptiveFollowUpAlert" class="p-3 bg-amber-50 border border-amber-200 rounded-xl flex items-center gap-2.5 hidden">
                    <i data-lucide="help-circle" class="w-4 h-4 text-amber-600 shrink-0"></i>
                    <p id="adaptiveFollowUpText" class="text-xs text-amber-800 font-medium">
                        The interviewer noticed missing concepts and is probing deeper!
                    </p>
                </div>

                <!-- Answer Area -->
                <div id="adaptiveInputSection" class="space-y-2">
                    <div class="flex justify-between items-center">
                        <label class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                            <i data-lucide="edit-3" class="w-3.5 h-3.5 text-teal-600"></i>
                            Your Technical Response:
                        </label>
                        <span id="adaptiveWordCount" class="text-[11px] font-mono text-slate-500">0 words</span>
                    </div>
                    <textarea id="adaptiveAnswerInput" rows="4" onkeyup="updateAdaptiveWordCount()" class="w-full text-xs p-3 bg-slate-50 border border-slate-300 rounded-xl font-mono outline-none focus:ring-2 focus:ring-teal-500 leading-relaxed" placeholder="Type or speak your technical answer..."></textarea>
                    
                    <div class="flex justify-between items-center pt-1">
                        <span class="text-[11px] text-slate-500">Gemini Dual-Engine Active with offline fallback.</span>
                        <button onclick="submitAdaptiveTurnAnswer()" id="btnSubmitAdaptiveTurn" class="px-5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl text-xs font-bold transition shadow flex items-center gap-2 cursor-pointer">
                            <i data-lucide="send" class="w-4 h-4"></i>
                            <span>Submit Turn Answer</span>
                        </button>
                    </div>
                </div>

                <!-- Session Final Scorecard (Hidden until complete) -->
                <div id="adaptiveScorecardContainer" class="hidden p-5 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-2xl border border-indigo-700/50 space-y-4 shadow-xl">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="px-2.5 py-0.5 bg-emerald-500 text-slate-950 text-[10px] font-bold rounded-full uppercase font-mono">INTERVIEW COMPLETE</span>
                            <h4 class="text-lg font-bold text-white mt-1">Multi-Turn Performance Scorecard</h4>
                        </div>
                        <div class="text-right">
                            <span class="text-[11px] text-slate-300 block">Overall Score</span>
                            <span id="adaptiveFinalScore" class="text-3xl font-black text-emerald-400">--/100</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2.5 text-center text-xs">
                        <div class="p-3 bg-white/10 rounded-xl">
                            <span class="text-[10px] text-slate-300 block">Technical Score</span>
                            <span id="adaptiveFinalTech" class="text-base font-bold text-white mt-0.5">--</span>
                        </div>
                        <div class="p-3 bg-white/10 rounded-xl">
                            <span class="text-[10px] text-slate-300 block">Communication</span>
                            <span id="adaptiveFinalComm" class="text-base font-bold text-white mt-0.5">--</span>
                        </div>
                        <div class="p-3 bg-white/10 rounded-xl">
                            <span class="text-[10px] text-slate-300 block">Speaking Rate</span>
                            <span id="adaptiveFinalWpm" class="text-base font-bold text-white mt-0.5">-- WPM</span>
                        </div>
                    </div>
                    <div class="p-3 bg-white/5 rounded-xl border border-white/10 text-xs space-y-1">
                        <span class="text-[10px] text-amber-300 uppercase font-bold font-mono">Panel Verdict:</span>
                        <p id="adaptiveFinalVerdict" class="text-xs text-slate-200 font-medium">PASSED</p>
                    </div>
                    <!-- Strengths and Weak Areas -->
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div class="p-3 bg-emerald-950/40 border border-emerald-500/30 rounded-xl space-y-1">
                            <span class="text-[10px] text-emerald-300 uppercase font-bold font-mono flex items-center gap-1">✓ Mastered Concepts:</span>
                            <div id="adaptiveStrengthsPills" class="flex flex-wrap gap-1 pt-1"></div>
                        </div>
                        <div class="p-3 bg-rose-950/40 border border-rose-500/30 rounded-xl space-y-1">
                            <span class="text-[10px] text-rose-300 uppercase font-bold font-mono flex items-center gap-1">⚠ Practice Deficits:</span>
                            <div id="adaptiveWeakAreasPills" class="flex flex-wrap gap-1 pt-1"></div>
                        </div>
                    </div>
                    <!-- Recommendations -->
                    <div class="p-3 bg-white/5 rounded-xl border border-white/10 text-xs space-y-1">
                        <span class="text-[10px] text-indigo-300 uppercase font-bold font-mono">Autonomous Practice Plan:</span>
                        <div id="adaptiveRecommendationsList" class="space-y-1 text-slate-300 text-[11px] pt-1"></div>
                    </div>
                </div>

                <!-- History Log of Previous Turns -->
                <div class="space-y-2 pt-2 border-t border-slate-100">
                    <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                        <i data-lucide="history" class="w-3.5 h-3.5 text-slate-500"></i>
                        Session Dialogue History:
                    </span>
                    <div id="adaptiveHistoryList" class="space-y-2 text-xs"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Project Defense Viva Simulator Modal -->
    <div id="projectDefenseModal" class="fixed inset-0 bg-slate-950/75 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-3xl w-full overflow-hidden shadow-2xl border border-slate-200 flex flex-col max-h-[90vh]">
            <!-- Header -->
            <div class="bg-gradient-to-r from-purple-950 via-slate-900 to-indigo-950 text-white p-5 flex items-center justify-between border-b border-purple-800/40">
                <div class="flex items-center gap-3">
                    <div class="p-2.5 bg-purple-500 text-white rounded-xl font-bold shadow">
                        <i data-lucide="shield" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="bg-purple-500/20 text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider font-mono border border-purple-500/30">VIVA & EXAMINER PANEL</span>
                            <span class="bg-pink-500/20 text-pink-300 text-[10px] font-bold px-2 py-0.5 rounded-full font-mono">MAJOR PROJECT DEFENSE</span>
                        </div>
                        <h3 class="font-bold text-base text-white mt-0.5">Academic Major Project Defense Simulator</h3>
                    </div>
                </div>
                <button onclick="closeProjectDefenseModal()" class="text-slate-400 hover:text-white p-1 rounded-lg transition">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="p-6 overflow-y-auto space-y-5 flex-1">
                <!-- Project Parameters Input -->
                <div class="p-4 bg-slate-50 rounded-xl border border-slate-200 space-y-3 text-xs">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="space-y-1">
                            <label class="font-bold text-slate-700">Project Title:</label>
                            <input type="text" id="defenseTitleInput" class="w-full p-2 bg-white border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-purple-500 font-medium" value="AI-Powered Training & Placement Management System">
                        </div>
                        <div class="space-y-1">
                            <label class="font-bold text-slate-700">Tech Stack (Comma-separated):</label>
                            <input type="text" id="defenseStackInput" class="w-full p-2 bg-white border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-purple-500 font-mono" value="Python, FastAPI, SQLite, YOLOv8, MediaPipe, ReportLab">
                        </div>
                    </div>
                    <div class="space-y-1">
                        <label class="font-bold text-slate-700">Short Abstract / Architecture Summary:</label>
                        <input type="text" id="defenseDescInput" class="w-full p-2 bg-white border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-purple-500" value="Modular placement operations backend with explainable AI for resume parsing, speech fluency, 3D head pose proctoring, and automated dossier generation.">
                    </div>
                    <div class="flex justify-end pt-1">
                        <button onclick="generateDefenseQuestions()" id="btnGenDefenseQs" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-bold flex items-center gap-1.5 shadow transition cursor-pointer">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            <span>Generate 4 Viva Panel Questions</span>
                        </button>
                    </div>
                </div>

                <!-- Defense Questions Accordion/Cards Container -->
                <div id="defenseQuestionsContainer" class="space-y-4">
                    <p class="text-xs text-slate-500 text-center py-4">Click 'Generate 4 Viva Panel Questions' to start your technical defense preparation.</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Floating AI Career Mentor Chatbot Widget -->
    <script src="/static/chatbot.js"></script>
</body>
</html>
