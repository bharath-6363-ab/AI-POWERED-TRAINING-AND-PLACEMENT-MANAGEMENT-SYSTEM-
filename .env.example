# ==============================================================================
# AI-TPMS: AI-POWERED TRAINING & PLACEMENT MANAGEMENT SYSTEM CONFIGURATION
# ==============================================================================

# 1. Google Gemini API Key (Get your free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Database Selection
# Set to 'true' to run out-of-the-box with local SQLite (aitpms.db)
# Set to 'false' to connect to local MySQL 8+ server
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=aitpms.db

# 3. MySQL 8+ Server Settings (Active when USE_SQLITE_FALLBACK=false)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=aitpms_db

# 4. Authentication & JWT Security
SECRET_KEY=academic-major-project-super-secret-key-2026-xyz987
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 5. File Uploads Directory
UPLOAD_DIR=uploads
